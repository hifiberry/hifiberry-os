    def _call_tool(self, name: str, args: Dict[str, Any]) -> Dict[str, Any]:
        try:
            if name == "players_list":
                return self._acr_get("players")
            if name == "player_active":
                return self._acr_get("player")
            if name == "now_playing":
                return self._acr_get("now-playing")
            if name == "playback_command":
                return self._playback_command(args)
            if name == "player_queue":
                return self._player_queue(args)
            if name == "queue_add_track":
                return self._queue_add(args)
            if name == "queue_remove_index":
                return self._player_command(args.get("player"), f"remove_track:{args.get('index')}")
            if name == "queue_play_index":
                return self._player_command(args.get("player"), f"play_queue_index:{args.get('index')}")
            if name == "queue_clear":
                return self._player_command(args.get("player"), "clear_queue")
            if name == "library_players":
                return self._acr_get("library")
            if name == "library_info":
                return self._acr_get(f"library/{self._enc(args.get('player'))}")
            if name == "library_albums":
                return self._acr_get(f"library/{self._enc(args.get('player'))}/albums")
            if name == "library_artists":
                return self._acr_get(f"library/{self._enc(args.get('player'))}/artists")
            if name == "library_album_by_id":
                return self._acr_get(
                    f"library/{self._enc(args.get('player'))}/album/by-id/{self._enc(args.get('album_id'))}"
                )
            if name == "library_albums_by_artist":
                path = f"library/{self._enc(args.get('player'))}/albums/by-artist/{self._enc(args.get('artist_name'))}"
                if args.get("fuzzy"):
                    path += "?fuzzy=true"
                return self._acr_get(path)
            if name == "library_artist_by_name":
                path = f"library/{self._enc(args.get('player'))}/artist/by-name/{self._enc(args.get('artist_name'))}"
                if args.get("fuzzy"):
                    path += "?fuzzy=true"
                return self._acr_get(path)
            if name == "library_genres":
                path = f"library/{self._enc(args.get('player'))}/genres"
                if args.get("raw"):
                    path += "?raw=true"
                return self._acr_get(path)
            if name == "library_albums_by_genre":
                return self._acr_get(
                    f"library/{self._enc(args.get('player'))}/albums/by-genre/{self._enc(args.get('genre'))}"
                )
            if name == "library_artists_by_genre":
                return self._acr_get(
                    f"library/{self._enc(args.get('player'))}/artists/by-genre/{self._enc(args.get('genre'))}"
                )
            if name == "library_refresh":
                return self._acr_get(f"library/{self._enc(args.get('player'))}/refresh")
            if name == "library_update":
                return self._acr_post(f"library/{self._enc(args.get('player'))}/update", {})
            if name == "genre_config_get":
                return self._acr_get("genres/config")
            if name == "genre_config_user_get":
                return self._acr_get("genres/user-config")
            if name == "genre_mapping_set":
                return self._acr_post("genres/mapping", {"from": args.get("from"), "to": args.get("to")})
            if name == "genre_mapping_delete":
                return self._acr_delete(f"genres/mapping/{self._enc(args.get('from'))}")
            if name == "genre_ignore_add":
                return self._acr_post("genres/ignore", {"genre": args.get("genre")})
            if name == "genre_ignore_remove":
                return self._acr_delete(f"genres/ignore/{self._enc(args.get('genre'))}")
            return self._err_text(f"Unknown tool: {name}")
        except Exception as err:
            return self._err_text(f"Tool execution failed: {err}\n{traceback.format_exc()}")

    def _enc(self, value: Any) -> str:
        if value is None:
            raise ValueError("Missing required argument")
        return quote(str(value), safe="")

    def _acr_get(self, path: str) -> Dict[str, Any]:
        result = self.acr.request("GET", path)
        if result.get("ok"):
            return self._ok_text(result.get("data"))
        return self._err_text(json.dumps(result, ensure_ascii=False))

    def _acr_post(self, path: str, body: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
        result = self.acr.request("POST", path, body=body)
        if result.get("ok"):
            return self._ok_text(result.get("data"))
        return self._err_text(json.dumps(result, ensure_ascii=False))

    def _acr_put(self, path: str, body: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
        result = self.acr.request("PUT", path, body=body)
        if result.get("ok"):
            return self._ok_text(result.get("data"))
        return self._err_text(json.dumps(result, ensure_ascii=False))

    def _acr_delete(self, path: str) -> Dict[str, Any]:
        result = self.acr.request("DELETE", path)
        if result.get("ok"):
            return self._ok_text(result.get("data"))
        return self._err_text(json.dumps(result, ensure_ascii=False))

    def _player_command(self, player: Any, command: str, body: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
        if not player:
            return self._err_text("Missing required argument: player")
        path = f"player/{self._enc(player)}/command/{self._enc(command)}"
        return self._acr_post(path, body)

    def _playback_command(self, args: Dict[str, Any]) -> Dict[str, Any]:
        player = args.get("player")
        command = args.get("command")
        if command not in {"play", "pause", "stop", "next", "previous"}:
            return self._err_text("Invalid command. Allowed: play, pause, stop, next, previous")
        return self._player_command(player, command)

    def _player_queue(self, args: Dict[str, Any]) -> Dict[str, Any]:
        player = args.get("player")
        if not player:
            return self._err_text("Missing required argument: player")
        return self._acr_get(f"player/{self._enc(player)}/queue")

    def _queue_add(self, args: Dict[str, Any]) -> Dict[str, Any]:
        player = args.get("player")
        uri = args.get("uri")
        if not player or not uri:
            return self._err_text("Missing required arguments: player, uri")
        body: Dict[str, Any] = {"uri": uri}
        if isinstance(args.get("metadata"), dict):
            body["metadata"] = args["metadata"]
        return self._player_command(player, "add_track", body)


def main() -> int:
    parser = argparse.ArgumentParser(description="ACR MCP server (stdio or HTTP)")
    parser.add_argument(
        "--transport",
        choices=["stdio", "http"],
        default=os.environ.get("ACR_MCP_TRANSPORT", "stdio"),
        help="MCP transport mode",
    )
    parser.add_argument(
        "--host",
        default=os.environ.get("ACR_MCP_HOST", "127.0.0.1"),
        help="HTTP host (http transport only)",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=int(os.environ.get("ACR_MCP_PORT", "13180")),
        help="HTTP port (http transport only)",
    )
    args = parser.parse_args()

    mcp_server = MCPServer()

    if args.transport == "stdio":
        mcp_server.run()
        return 0

    class MCPHttpHandler(BaseHTTPRequestHandler):
        def _send_json(self, status_code: int, payload: Dict[str, Any]) -> None:
            body = json.dumps(payload, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
            self.send_response(status_code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self) -> None:
            if self.path == "/health":
                self._send_json(200, {"ok": True, "server": SERVER_NAME, "version": SERVER_VERSION})
                return
            self._send_json(404, {"error": "not found"})

        def do_POST(self) -> None:
            if self.path != "/mcp":
                self._send_json(404, {"error": "not found"})
                return

            try:
                content_length = int(self.headers.get("Content-Length", "0"))
                raw = self.rfile.read(content_length)
                msg = json.loads(raw.decode("utf-8", errors="replace"))
            except Exception as err:
                self._send_json(400, {"error": f"invalid request body: {err}"})
                return

            response = mcp_server.process_message(msg)
            if response is None:
                self.send_response(204)
                self.end_headers()
                return
            self._send_json(200, response)

    httpd = ThreadingHTTPServer((args.host, args.port), MCPHttpHandler)
    print(f"{SERVER_NAME} listening on http://{args.host}:{args.port}/mcp", file=sys.stderr)
    httpd.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
