#!/bin/bash

set -e

SUFFIX=-hifiberry-sbuild
CHROOT_ARCH=arm64
VERSION=bookworm
MIRROR=http://deb.debian.org/debian
CLEAN_MODE=false

# Parse command line arguments
for arg in "$@"; do
    case "$arg" in
        --clean)
            CLEAN_MODE=true
            echo "Clean mode enabled - will clean and rebuild all packages"
            ;;
        amd64|arm64|armhf)
            CHROOT_ARCH="$arg"
            ;;
        *)
            echo "Warning: unknown argument '$arg' ignored"
            ;;
    esac
done

# Check architecture
if [ "$CHROOT_ARCH" != "amd64" ] && [ "$CHROOT_ARCH" != "arm64" ] && [ "$CHROOT_ARCH" != "armhf" ]; then
    echo "Error: architecture must be 'amd64', 'arm64', or 'armhf'"
    exit 1
fi

mkdir -p ~/.cache/sbuild

#Check if the tarball does already exists, in that case we do not have to create a new one.
TARBALL_PATH="$HOME/.cache/sbuild/$VERSION-$CHROOT_ARCH.tar.zst"

if [ ! -f "$TARBALL_PATH" ]; then
	echo "Creating Tarball for version: $VERSION, architecture: $CHROOT_ARCH"
	mmdebstrap \
  		--arch=$CHROOT_ARCH \
  		--include=ca-certificates \
  		--skip=output/dev \
  		--variant=buildd \
  		bookworm \
  		~/.cache/sbuild/$VERSION-$CHROOT_ARCH.tar.zst \
  		$MIRROR
fi

# Define the packages directory
PACKAGES_DIR="$HOME/packages"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
echo "Looking for build.sh in subdirectories of $SCRIPT_DIR..."

for dir in "$SCRIPT_DIR"/*/; do
    figlet `basename $dir`
    if [ -f "$dir/build.sh" ]; then
        echo "Found build.sh in $dir"
        
        # Check if .deb files already exist (unless cleaning)
        if [ "$CLEAN_MODE" = false ] && ls "$dir"/*.deb 1> /dev/null 2>&1; then
            echo "Found existing .deb files in $dir. Skipping build (use --clean to force rebuild)..."
            echo 
            sleep 1
            continue
        fi
        
        echo "Executing build process..."
        (
            cd "$dir"
            chmod ugo+x ./build.sh 2>/dev/null || true
            chmod ugo+x ./clean.sh 2>/dev/null || true
            
            # Run clean.sh only if clean mode is enabled or if it doesn't exist
            if [ "$CLEAN_MODE" = true ] && [ -f clean.sh ]; then
                echo "Running clean.sh in $dir..."
                ./clean.sh
            fi
            
            echo "Running build.sh in $dir..."
            ./build.sh $CHROOT_ARCH
            echo
            sleep 2
        )
    else
        echo "No build.sh found in $dir. Skipping..."
    fi
done

echo "All builds completed."

