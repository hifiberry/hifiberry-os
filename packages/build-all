#!/bin/bash

set -e

# Parse command line arguments
CLEAN_ARG=""
if [ "$1" = "--clean" ]; then
    CLEAN_ARG="--clean"
    echo "Clean mode enabled - will clean and rebuild all packages"
fi

SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[1]}")")"
echo "Building all packages in $SCRIPT_DIR..."

for dir in "$SCRIPT_DIR"/*/; do
    figlet "$(basename "$dir")"

    if [[ -f "$dir/build.config" || -d "$dir/src" ]]; then

        if [[ "$CLEAN_ARG" != "--clean" ]] && ls "$dir"/*.deb 1> /dev/null 2>&1; then
            echo "Found existing .deb files in $dir. Skipping build (use --clean to force rebuild)..."
            echo 
            continue
        fi

        echo "Found build config or source in $dir"

        $SCRIPT_DIR/build "./$dir" $CLEAN_ARG
    else
        echo "No build.config or src found in $dir. Skipping..."
    fi
done

echo "All builds completed."

