[Unit]
Description=HiFiBerry Music Player Daemon (user)
Documentation=https://www.musicpd.org/
After=pipewire.service network.target
Wants=network.target

[Service]
Type=simple
# Ensure user config exists and has proper mixer settings
ExecStartPre=/usr/bin/configure-mpd
ExecStart=/usr/bin/mpd --no-daemon %h/etc/mpd.conf
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target