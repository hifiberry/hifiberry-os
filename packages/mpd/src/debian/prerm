#!/bin/bash
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Ensure system socket is disabled/removed if it exists from previous versions
        if [ -x /bin/systemctl ] || [ -x /usr/bin/systemctl ]; then
            systemctl stop mpd.socket 2>/dev/null || true
            systemctl disable mpd.socket 2>/dev/null || true
        fi
        rm -f /etc/systemd/system/sockets.target.wants/mpd.socket || true
        ;;
    
    failed-upgrade)
        ;;
    
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
