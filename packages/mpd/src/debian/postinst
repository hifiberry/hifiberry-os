#!/bin/bash
set -e

# User-service: no system users or global config setup required.
case "$1" in
    configure)
        :
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        :
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
