--- a/src/lib/alsa/NonBlock.cxx	2026-08-28 10:35:31
+++ b/src/lib/alsa/NonBlock.cxx	2026-08-28 10:58:23
@@ -5,6 +5,8 @@
 #include "Error.hxx"
 #include "event/MultiSocketMonitor.hxx"
 
+#include <chrono>
+
 namespace Alsa {
 
 std::span<pollfd>
@@ -50,7 +52,24 @@
 	}
 
 	m.ReplaceSocketList(pfds.first(count));
-	return Event::Duration(-1);
+
+	/* Workaround for PipeWire's ALSA compatibility plugin
+	   (libasound_module_pcm_pipewire.so): after snd_pcm_drop(), its poll
+	   descriptor never becomes ready again.  A purely descriptor-driven
+	   event loop would therefore never call DispatchSockets() again, and
+	   would never reach the snd_pcm_prepare() that revives the stream --
+	   playback freezes for good after "next", "previous" or a seek.  A
+	   real ALSA device reports the descriptor as ready immediately while
+	   in SND_PCM_STATE_SETUP, which is why this only bites on PipeWire.
+
+	   While the stream is running, keep waiting on the descriptor alone,
+	   so the hot path gets no additional wakeups.  In every other state,
+	   also arm a timeout so the state machine can always make progress.
+	   AlsaOutput::DispatchSockets() re-arms it until the stream runs. */
+	if (snd_pcm_state(pcm) == SND_PCM_STATE_RUNNING)
+		return Event::Duration(-1);
+
+	return std::chrono::milliseconds(10);
 }
 
