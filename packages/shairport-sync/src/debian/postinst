#!/bin/bash
set -e

# Create directories first
if [ ! -d /var/lib/shairport ]; then
    mkdir -p /var/lib/shairport
fi

# Create shairport-sync group if it doesn't exist
if ! getent group shairport-sync > /dev/null; then
    addgroup --system shairport-sync
fi

# Create shairport-sync user if it doesn't exist
if ! getent passwd shairport-sync > /dev/null; then
    adduser --system --ingroup shairport-sync --home /var/lib/shairport --no-create-home --shell /usr/sbin/nologin shairport-sync
    usermod -a -G audio shairport-sync
fi

# Set ownership and permissions for directories after users are created
chown shairport-sync:shairport-sync /var/lib/shairport
chmod 755 /var/lib/shairport

# Add shairport-sync user to pipewire group for PipeWire integration
if getent group pipewire > /dev/null; then
    usermod -a -G pipewire shairport-sync || true
fi

# Create main configuration file from default if it doesn't exist
if [ ! -f /etc/shairport-sync.conf ] && [ -f /etc/shairport-sync.conf.default ]; then
    echo "Creating /etc/shairport-sync.conf from default template"
    cp /etc/shairport-sync.conf.default /etc/shairport-sync.conf
    chmod 644 /etc/shairport-sync.conf
fi

# Create runtime directory for shairport-sync (for backwards compatibility if needed)
if [ ! -d /var/run/shairport ]; then
    mkdir -p /var/run/shairport
    chown shairport-sync:shairport-sync /var/run/shairport
    chmod 755 /var/run/shairport
fi

# Note: nqptp 1.2.6+ uses AmbientCapabilities in systemd service instead of setcap

# Set capabilities for shairport binaries to allow real-time scheduling
if command -v setcap > /dev/null; then
    setcap 'cap_sys_nice=+ep' /usr/bin/shairport-airplay2 || true
    setcap 'cap_sys_nice=+ep' /usr/bin/shairport || true
fi

# Handle systemd service management based on installation type
case "$1" in
    configure)
        # Fresh installation - debhelper will handle service enabling
        if [ -z "$2" ]; then
            echo "Fresh installation - services will be enabled by debhelper"
        else
            echo "Package upgrade - services will be handled by debhelper"
        fi

        # Register in Web UI player registry
        HBOS_PLAYERS_D="/etc/hifiberry/players.d"
        mkdir -p "$HBOS_PLAYERS_D/icons"

        cat > "$HBOS_PLAYERS_D/shairport.json" <<'PLAYEREOF'
{
    "name": "Airplay",
    "provided_by": "shairport-sync",
    "systemd_service": "shairport",
    "icon": "shairport",
    "allow_change": true,
    "maintainer_name": "Wanted",
    "maintainer_url": "https://github.com/hifiberry/hifiberry-os/blob/hbosng/docs/maintainers-wanted.md"
}
PLAYEREOF

        # Install icon
        if [ -f /usr/share/hifiberry-shairport/icons/airplay.svg ]; then
            cp /usr/share/hifiberry-shairport/icons/airplay.svg "$HBOS_PLAYERS_D/icons/shairport.svg"
        fi

        echo "Registered Airplay in Web UI player registry."

        # Register systemd permissions via configserver drop-in
        mkdir -p /etc/configserver/conf.d
        cat > /etc/configserver/conf.d/shairport.json <<'CONFEOF'
{
    "systemd": {
        "shairport": "all"
    }
}
CONFEOF

        echo "Configserver drop-in installed for shairport."

        # config-server caches conf.d systemd-permission drop-ins at startup; when
        # this package is installed onto a running system, restart it so the WebUI
        # can control this player. No-op during image builds (config-server not up).
        if [ -d /run/systemd/system ] && systemctl is-active --quiet config-server 2>/dev/null; then
            systemctl restart config-server >/dev/null 2>&1 || true
        fi

        # D-Bus policy for the shairport-sync control interface.
        # shairport-sync exposes org.gnome.ShairportSync on the system bus (used by
        # audiocontrol to DropSession/RemoteCommand when switching sources). The
        # shipped policy only lets "root"/"shairport-sync" own those names, but on
        # HiFiBerryOS shairport-sync runs as the configured media-player user
        # (/etc/hifiberry.user). Generate an own-policy for that user so the
        # interface can actually be acquired.
        HB_USER=""
        if [ -f /etc/hifiberry.user ]; then
            HB_USER=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$' /etc/hifiberry.user | head -1 | tr -d '[:space:]')
        fi
        if [ -n "$HB_USER" ] && getent passwd "$HB_USER" >/dev/null 2>&1; then
            mkdir -p /usr/share/dbus-1/system.d
            cat > /usr/share/dbus-1/system.d/shairport-sync-hifiberry.conf <<DBUSEOF
<!DOCTYPE busconfig PUBLIC
 "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<!-- Generated by hifiberry-shairport postinst from /etc/hifiberry.user.
     Do not edit; regenerated on every (re)install. -->
<busconfig>
  <policy user="$HB_USER">
    <allow own="org.gnome.ShairportSync"/>
    <allow own="org.mpris.MediaPlayer2.ShairportSync"/>
  </policy>
</busconfig>
DBUSEOF
            echo "Installed D-Bus own-policy for shairport-sync as user '$HB_USER'."
            # Reload the system D-Bus so the new policy applies, then restart
            # shairport (user service) so it re-acquires the name. Best effort;
            # no-op during image builds.
            if [ -d /run/systemd/system ]; then
                systemctl reload dbus >/dev/null 2>&1 || systemctl reload dbus.service >/dev/null 2>&1 || true
                HB_UID=$(id -u "$HB_USER" 2>/dev/null)
                if [ -n "$HB_UID" ] && [ -d "/run/user/$HB_UID" ]; then
                    systemd-run --uid "$HB_UID" --setenv XDG_RUNTIME_DIR="/run/user/$HB_UID" \
                        --pipe --wait --quiet --collect \
                        systemctl --user restart shairport.service >/dev/null 2>&1 || true
                fi
            fi
        fi

        # Register with ACR
        if [ -d /etc/audiocontrol ]; then
            # The player definition itself now ships as a static conffile at
            # /etc/audiocontrol/players.d/shairport.json (installed by
            # debian/rules), so dpkg owns it and preserves local edits across
            # upgrades. Do not (re)write it here - that would defeat conffile
            # handling by silently clobbering it on every install/upgrade.

            # Remove any stale inline "shairport" definition from the main
            # audiocontrol config so the player is not loaded twice (a
            # duplicate shairport listener fails to bind UDP port 5555 and
            # breaks AirPlay metadata).
            ACR_MAIN="/etc/audiocontrol/audiocontrol.json"
            if [ -f "$ACR_MAIN" ] && command -v python3 >/dev/null 2>&1; then
                python3 - "$ACR_MAIN" shairport <<'PYEOF'
import json, os, sys
path, key = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        data = json.load(f)
    players = data.get("players") if isinstance(data, dict) else None
    if isinstance(players, list):
        kept = [p for p in players if not (isinstance(p, dict) and key in p)]
        if len(kept) != len(players):
            data["players"] = kept
            tmp = path + ".acrtmp"
            with open(tmp, "w") as out:
                json.dump(data, out, indent=4)
                out.write("\n")
            os.replace(tmp, path)
            print("Removed stale inline '%s' player from audiocontrol.json" % key)
except Exception as e:
    sys.stderr.write("audiocontrol inline cleanup skipped: %s\n" % e)
sys.exit(0)
PYEOF
            fi
        fi
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        # Nothing to do in these cases
        ;;
esac

#DEBHELPER#
