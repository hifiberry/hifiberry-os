#!/usr/bin/make -f

# Shairport Sync version configuration
SHAIRPORT_VERSION ?= 5.0
SHAIRPORT_COMMIT ?= df7bfcacfb9384b6f334aaa0320edb1e9f023e33

%:
	dh $@

override_dh_auto_configure:
	# Download and build NQPTP first
	@echo "Building NQPTP..."
	git clone https://github.com/mikebrady/nqptp.git nqptp
	cd nqptp && git checkout 1.2.6
	cd nqptp && autoreconf -fi && ./configure --with-systemd-startup && make
	
	# Download and build metadata reader
	@echo "Building metadata reader..."
	git clone https://github.com/mikebrady/shairport-sync-metadata-reader.git metadata-reader
	cd metadata-reader && autoreconf -fi && ./configure && make
	
	# Download shairport-sync source
	@echo "Downloading shairport-sync source (version $(SHAIRPORT_VERSION), commit $(SHAIRPORT_COMMIT))..."
	git clone https://github.com/mikebrady/shairport-sync.git shairport-sync-$(SHAIRPORT_VERSION)
	cd shairport-sync-$(SHAIRPORT_VERSION) && git checkout $(SHAIRPORT_COMMIT)
	
	# Create two copies for different builds
	cp -r shairport-sync-$(SHAIRPORT_VERSION) shairport-sync-airplay2
	cp -r shairport-sync-$(SHAIRPORT_VERSION) shairport-sync-legacy
	
	# Configure AirPlay 2 version
	@echo "Configuring AirPlay 2 version..."
	cd shairport-sync-airplay2 && autoreconf -fi
	cd shairport-sync-airplay2 && ./configure --prefix=/usr --sysconfdir=/etc --with-airplay-2 --with-ssl=openssl --without-mqtt-client --with-dbus-interface --with-mpris-interface --with-avahi --with-alsa --without-soxr --without-pipe --without-stdout --with-metadata
	
	# Configure legacy version (without AirPlay 2)
	@echo "Configuring legacy version..."
	cd shairport-sync-legacy && autoreconf -fi
	cd shairport-sync-legacy && ./configure --prefix=/usr --sysconfdir=/etc --with-ssl=openssl --without-mqtt-client --with-dbus-interface --with-mpris-interface --with-avahi --with-alsa --without-soxr --without-pipe --without-stdout --with-metadata

override_dh_auto_build:
	# Build AirPlay 2 version
	@echo "Building AirPlay 2 version..."
	cd shairport-sync-airplay2 && make
	
	# Build legacy version
	@echo "Building legacy version..."
	cd shairport-sync-legacy && make

override_dh_auto_install:
	# Install AirPlay 2 version as shairport-airplay2
	cd shairport-sync-airplay2 && sed -i '/getent group/d' Makefile && sed -i '/getent passwd/d' Makefile && sed -i '/cp \.\/scripts\/shairport-sync\.conf/d' Makefile
	cd shairport-sync-airplay2 && make install DESTDIR=$(CURDIR)/debian/hifiberry-shairport AM_UPDATE_INFO_DIR=no
	# Rename the binary to shairport-airplay2
	mv $(CURDIR)/debian/hifiberry-shairport/usr/bin/shairport-sync $(CURDIR)/debian/hifiberry-shairport/usr/bin/shairport-airplay2
	
	# Install legacy version as shairport
	cd shairport-sync-legacy && sed -i '/getent group/d' Makefile && sed -i '/getent passwd/d' Makefile && sed -i '/cp \.\/scripts\/shairport-sync\.conf/d' Makefile
	cd shairport-sync-legacy && make install DESTDIR=$(CURDIR)/debian/hifiberry-shairport AM_UPDATE_INFO_DIR=no bindir=/usr/bin/temp-legacy
	# Move and rename the legacy binary to shairport
	mv $(CURDIR)/debian/hifiberry-shairport/usr/bin/temp-legacy/shairport-sync $(CURDIR)/debian/hifiberry-shairport/usr/bin/shairport
	# Clean up temp directory
	rmdir $(CURDIR)/debian/hifiberry-shairport/usr/bin/temp-legacy
	
	# Remove any upstream configuration files that conflict with ours
	rm -f $(CURDIR)/debian/hifiberry-shairport/etc/shairport-sync.conf*
	
	# Remove any .sh scripts installed by upstream that we'll replace
	rm -f $(CURDIR)/debian/hifiberry-shairport/usr/bin/*.sh
	
	# Remove any upstream systemd service files that we'll replace
	rm -f $(CURDIR)/debian/hifiberry-shairport/lib/systemd/system/shairport-sync.service
	
	# Remove any upstream systemd service files that conflict with ours
	rm -f $(CURDIR)/debian/hifiberry-shairport/lib/systemd/system/shairport-sync.service
	rm -f $(CURDIR)/debian/hifiberry-shairport/usr/lib/systemd/system/shairport-sync.service
	rm -f $(CURDIR)/debian/hifiberry-shairport/shairport-sync.service	
	
	# Move DBus policy files to correct location
	if [ -d "$(CURDIR)/debian/hifiberry-shairport/etc/dbus-1/system.d" ]; then \
		mkdir -p $(CURDIR)/debian/hifiberry-shairport/usr/share/dbus-1/system.d/; \
		mv $(CURDIR)/debian/hifiberry-shairport/etc/dbus-1/system.d/*.conf $(CURDIR)/debian/hifiberry-shairport/usr/share/dbus-1/system.d/; \
		rmdir $(CURDIR)/debian/hifiberry-shairport/etc/dbus-1/system.d || true; \
		rmdir $(CURDIR)/debian/hifiberry-shairport/etc/dbus-1 || true; \
	fi
	
	# Install systemd user service files
	install -D -m644 systemd/shairport.service $(CURDIR)/debian/hifiberry-shairport/usr/lib/systemd/user/shairport.service
	install -D -m644 systemd/nqptp.service $(CURDIR)/debian/hifiberry-shairport/usr/lib/systemd/user/nqptp.service
	
	# Install NQPTP binary and man page
	install -D -m755 nqptp/nqptp $(CURDIR)/debian/hifiberry-shairport/usr/bin/nqptp
	if [ -f "nqptp/nqptp.1" ]; then \
		install -D -m644 nqptp/nqptp.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/nqptp.1; \
	else \
		install -D -m644 man/nqptp.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/nqptp.1; \
	fi
	
	# Install metadata reader
	install -D -m755 metadata-reader/shairport-sync-metadata-reader $(CURDIR)/debian/hifiberry-shairport/usr/bin/shairport-sync-metadata-reader
	install -D -m644 man/shairport-sync-metadata-reader.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/shairport-sync-metadata-reader.1
	
	# Install custom scripts (remove .sh extensions)
	install -D -m755 start-shairport.sh $(CURDIR)/debian/hifiberry-shairport/usr/bin/start-shairport
	install -D -m755 start-nqptp.sh $(CURDIR)/debian/hifiberry-shairport/usr/bin/start-nqptp
	install -D -m755 shairport-event.sh $(CURDIR)/debian/hifiberry-shairport/usr/bin/shairport-event
	install -D -m755 shairport-metadata-example.sh $(CURDIR)/debian/hifiberry-shairport/usr/bin/shairport-metadata-example
	install -D -m755 shairport-playpause.sh $(CURDIR)/debian/hifiberry-shairport/usr/bin/shairport-playpause
	
	# Install man pages for event scripts
	install -D -m644 man/start-shairport.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/start-shairport.1
	install -D -m644 man/start-nqptp.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/start-nqptp.1
	install -D -m644 man/shairport-event-start.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/shairport-event-start.1
	install -D -m644 man/shairport-event-stop.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/shairport-event-stop.1
	install -D -m644 man/shairport-event.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/shairport-event.1
	install -D -m644 man/shairport-metadata-example.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/shairport-metadata-example.1
	install -D -m644 man/shairport-playpause.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/shairport-playpause.1
	install -D -m644 man/shairport.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/shairport.1
	install -D -m644 man/shairport-airplay2.1 $(CURDIR)/debian/hifiberry-shairport/usr/share/man/man1/shairport-airplay2.1
	
	# Install default configuration file
	install -D -m644 shairport-sync.conf.default $(CURDIR)/debian/hifiberry-shairport/etc/shairport-sync.conf.default
	
	# Install icon for player registry
	install -D -m644 icons/airplay.svg $(CURDIR)/debian/hifiberry-shairport/usr/share/hifiberry-shairport/icons/airplay.svg

	# Create symlinks for start and stop scripts (these point to the event handler)
	mkdir -p $(CURDIR)/debian/hifiberry-shairport/usr/bin/
	ln -sf /usr/bin/shairport-event $(CURDIR)/debian/hifiberry-shairport/usr/bin/shairport-event-start
	ln -sf /usr/bin/shairport-event $(CURDIR)/debian/hifiberry-shairport/usr/bin/shairport-event-stop

override_dh_auto_clean:
	rm -rf nqptp/
	rm -rf metadata-reader/
	rm -rf shairport-sync-$(SHAIRPORT_VERSION)/
	rm -rf shairport-sync-airplay2/
	rm -rf shairport-sync-legacy/

override_dh_auto_test:
	# Skip tests - requires audio hardware and network setup

override_dh_strip:
	# Strip binaries but don't create separate debug symbol packages
	dh_strip --no-automatic-dbgsym
