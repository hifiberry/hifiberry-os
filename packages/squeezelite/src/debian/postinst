#!/bin/bash
set -e

case "$1" in
    configure)
        # Create squeezelite user and group if they don't exist
        if ! getent group squeezelite > /dev/null; then
            addgroup --quiet --system squeezelite
        fi
        if ! getent passwd squeezelite > /dev/null; then
            adduser --quiet --system --ingroup squeezelite --no-create-home --home /var/lib/squeezelite squeezelite
            usermod -a -G audio squeezelite
        fi

        # Create home directory for squeezelite if it doesn't exist
        if [ ! -d /var/lib/squeezelite ]; then
            mkdir -p /var/lib/squeezelite
            chown squeezelite:squeezelite /var/lib/squeezelite
        fi

        # Up to 2.0.0.1565 this postinst wrote the WebUI descriptor and its icon
        # into /etc/hifiberry/players.d. 2.0.0.1565 moved both to
        # /usr/share/hifiberry/players.d, and configurator lets /etc shadow
        # /usr/share -- so the copy written here masked the packaged one and
        # nothing ever read it. The move changed where the files ship; it did
        # not stop this postinst overwriting them.
        #
        # The two copies are identical today, so nothing is visibly broken.
        # That is the reason to fix it now: the next field added to the shipped
        # descriptor would be masked silently, which is how hifiberry-librespot
        # lost a conflicts_with declaration and hifiberry-shairport lost its
        # entire settings block.
        #
        # Remove the stale copy, but only when upgrading from an affected
        # version. On a fresh install a file here is an administrator's own
        # override, which is what /etc is for.
        if [ -n "$2" ] && dpkg --compare-versions "$2" lt 2.0.0.1566; then
            rm -f /etc/hifiberry/players.d/squeezelite.json
            rm -f /etc/hifiberry/players.d/icons/squeezelite.svg
            echo "Removed the /etc descriptor that shadowed the packaged one."
        fi

        # Register systemd permissions via configserver drop-in
        mkdir -p /etc/configserver/conf.d
        cat > /etc/configserver/conf.d/squeezelite.json <<'CONFEOF'
{
    "systemd": {
        "squeezelite": "all"
    }
}
CONFEOF

        echo "Configserver drop-in installed for squeezelite."

        # NOTE: deliberately no `systemctl restart config-server` here.
        #
        # When the WebUI installs an extension, config-server is the process running
        # apt, and it holds the install job the UI polls in memory. Restarting from a
        # postinst -- which runs during dpkg's configure step, mid-install -- destroys
        # that job. apt survives (the runner starts it under systemd-run) so the
        # package installs correctly, but the UI is left polling an id that no longer
        # exists and reports the install as lost.
        #
        # It is also unnecessary: configurator re-reads conf.d in place after every
        # extension install, via refresh_system_state() in
        # configurator/extensions/postinstall.py, whose docstring says exactly why --
        # "Restarting is not an option here: it would kill the job the UI is polling."
        #
        # Caveat for a manual `apt install` from a shell: nothing calls
        # refresh_system_state() on that path, so config-server keeps its cached
        # conf.d until restarted by hand.

        # The ACR player definition now ships as a conffile installed by
        # debian/rules at /etc/audiocontrol/players.d/squeezelite.json
        # (key "lms"). Nothing to write here anymore.
        if [ -d /etc/audiocontrol ]; then
            # Remove any stale inline "lms" definition from the main audiocontrol
            # config so the player is not loaded twice.
            ACR_MAIN="/etc/audiocontrol/audiocontrol.json"
            if [ -f "$ACR_MAIN" ] && command -v python3 >/dev/null 2>&1; then
                python3 - "$ACR_MAIN" lms <<'PYEOF'
import json, os, sys
path, key = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        data = json.load(f)
    players = data.get("players") if isinstance(data, dict) else None
    if isinstance(players, list):
        kept = [p for p in players if not (isinstance(p, dict) and key in p)]
        if len(kept) != len(players):
            data["players"] = kept
            tmp = path + ".acrtmp"
            with open(tmp, "w") as out:
                json.dump(data, out, indent=4)
                out.write("\n")
            os.replace(tmp, path)
            print("Removed stale inline '%s' player from audiocontrol.json" % key)
except Exception as e:
    sys.stderr.write("audiocontrol inline cleanup skipped: %s\n" % e)
sys.exit(0)
PYEOF
            fi
        fi
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#
exit 0
