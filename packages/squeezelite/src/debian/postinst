#!/bin/bash
set -e

case "$1" in
    configure)
        # Create squeezelite user and group if they don't exist
        if ! getent group squeezelite > /dev/null; then
            addgroup --quiet --system squeezelite
        fi
        if ! getent passwd squeezelite > /dev/null; then
            adduser --quiet --system --ingroup squeezelite --no-create-home --home /var/lib/squeezelite squeezelite
            usermod -a -G audio squeezelite
        fi

        # Create home directory for squeezelite if it doesn't exist
        if [ ! -d /var/lib/squeezelite ]; then
            mkdir -p /var/lib/squeezelite
            chown squeezelite:squeezelite /var/lib/squeezelite
        fi

        # Register in Web UI player registry
        HBOS_PLAYERS_D="/etc/hifiberry/players.d"
        mkdir -p "$HBOS_PLAYERS_D/icons"

        cat > "$HBOS_PLAYERS_D/squeezelite.json" <<'PLAYEREOF'
{
    "name": "LMS",
    "provided_by": "squeezelite",
    "systemd_service": "squeezelite",
    "icon": "squeezelite",
    "allow_change": true
}
PLAYEREOF

        # Install icon
        if [ -f /usr/share/hifiberry-squeezelite/icons/squeezelite.svg ]; then
            cp /usr/share/hifiberry-squeezelite/icons/squeezelite.svg "$HBOS_PLAYERS_D/icons/squeezelite.svg"
        fi

        echo "Registered LMS/squeezelite in Web UI player registry."

        # Register systemd permissions via configserver drop-in
        mkdir -p /etc/configserver/conf.d
        cat > /etc/configserver/conf.d/squeezelite.json <<'CONFEOF'
{
    "systemd": {
        "squeezelite": "all"
    }
}
CONFEOF

        echo "Configserver drop-in installed for squeezelite."

        # Register with ACR
        if [ -d /etc/audiocontrol ]; then
            ACR_PLAYERS_D="/etc/audiocontrol/players.d"
            mkdir -p "$ACR_PLAYERS_D"
            cat > "$ACR_PLAYERS_D/squeezelite.json" <<'ACREOF'
{
    "lms": {
        "enable": true,
        "server": null,
        "port": 9000,
        "autodiscovery": true,
        "player_name": null,
        "player_mac": [],
        "reconnection_interval": 30,
        "polling_interval": 30,
        "enable_library": false
    }
}
ACREOF
            echo "Registered squeezelite with ACR."
        fi
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#
exit 0
