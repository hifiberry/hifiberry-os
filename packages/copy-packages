#!/bin/sh

# Configuration variables
PACKAGE_DIR="$HOME/packages/trixie"
APTLY_REPO="hbos-trixie"

# Gate before anything is staged for publication.
#
# Set SKIP_PUBLISH_CHECKS=1 to bypass, and expect to regret it: every package
# problem we have had came from publishing artefacts the repository did not
# describe.
#
# Note there is deliberately no check-release.py call here. "Built but not
# published" is the normal state right before running this script - that is
# what it is for - so gating on it would abort every single time. Run
# check-release.py after publishing, to confirm the result.
if [ -z "$SKIP_PUBLISH_CHECKS" ]; then
    ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

    if [ -n "$ROOT" ] && [ -f "$ROOT/scripts/check-packages.py" ]; then
        echo "Checking packages/ consistency..."
        if ! python3 "$ROOT/scripts/check-packages.py" --root "$ROOT" --skip-versions; then
            echo "ERROR: packages/ is inconsistent - refusing to publish." >&2
            echo "  Fix it, or SKIP_PUBLISH_CHECKS=1 ./copy-packages" >&2
            exit 1
        fi
    fi

    # Publishing from a tree whose state was never committed is how the build
    # host became the only place that knew what shipped.
    if [ -n "$ROOT" ]; then
        dirty=$(git -C "$ROOT" status --porcelain --untracked-files=no)
        ahead=$(git -C "$ROOT" rev-list --count @{upstream}..HEAD 2>/dev/null || echo 0)
        if [ -n "$dirty" ] || [ "$ahead" != "0" ]; then
            echo "ERROR: hifiberry-os is not in sync with its remote." >&2
            [ -n "$dirty" ] && echo "  uncommitted changes:" >&2 && echo "$dirty" | sed 's/^/    /' >&2
            [ "$ahead" != "0" ] && echo "  $ahead commit(s) not pushed" >&2
            echo "  Commit and push first, or SKIP_PUBLISH_CHECKS=1 ./copy-packages" >&2
            exit 1
        fi
    fi
fi

# Remove debug symbol packages
rm -f */*dbgsym*.deb

# Copy packages to package directory, but don't overwrite existing ones
echo "Copying packages to $PACKAGE_DIR..."
mkdir -p "$PACKAGE_DIR"

copied=0
skipped=0
added_to_repo=0

for deb in */*.deb; do
    if [ -f "$deb" ]; then
        basename_deb=$(basename "$deb")
        target="$PACKAGE_DIR/$basename_deb"
        
        if [ -f "$target" ]; then
            echo "SKIPPED: $basename_deb (already exists in $PACKAGE_DIR)"
            skipped=$((skipped + 1))
        else
            cp "$deb" "$PACKAGE_DIR/"
            echo "COPIED: $basename_deb"
            copied=$((copied + 1))
            
            # Ask if the package should be added to the repository
            printf "Add $basename_deb to package repository? (y/N): "
            read -r answer
            case "$answer" in
                [Yy]|[Yy][Ee][Ss])
                    echo "Adding $basename_deb to repository..."
                    if aptly repo add "$APTLY_REPO" "$target"; then
                        echo "SUCCESS: $basename_deb added to repository"
                        added_to_repo=$((added_to_repo + 1))
                    else
                        echo "ERROR: Failed to add $basename_deb to repository"
                    fi
                    ;;
                *)
                    echo "Skipped adding $basename_deb to repository"
                    ;;
            esac
        fi
    fi
done

echo ""
echo "Summary:"
echo "  Copied: $copied packages"
echo "  Skipped: $skipped packages (already existed)"
echo "  Added to repository: $added_to_repo packages"
