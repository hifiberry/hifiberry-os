#!/usr/bin/make -f

# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1

# Librespot version and commit configuration
LIBRESPOT_VERSION = v0.8.0
# LIBRESPOT_COMMIT_ID = 987dfa5df2546a96d34582674a757a3dcc6036a7

# Rust build configuration
export CARGO_HOME = $(CURDIR)/debian/cargo_home
export RUSTUP_HOME = $(CURDIR)/debian/rustup_home

# Optimize Rust compilation for space efficiency and avoid /tmp
export CARGO_BUILD_JOBS = 1
export CARGO_INCREMENTAL = 0
export RUST_BACKTRACE = 0

%:
	dh $@

override_dh_auto_clean:
	dh_auto_clean
	rm -rf target/
	rm -rf librespot-source/target/
	rm -rf $(CARGO_HOME)
	rm -rf $(RUSTUP_HOME)
	rm -rf $(CURDIR)/build_tmp
	rm -rf $(CURDIR)/build_home
	rm -rf librespot-source/
	find . -name "*.rlib" -delete 2>/dev/null || true
	find . -name "*.rmeta" -delete 2>/dev/null || true

override_dh_auto_configure:
	# Install Rust if not available
	if ! which cargo >/dev/null 2>&1; then \
		mkdir -p $(RUSTUP_HOME) $(CARGO_HOME); \
		curl https://sh.rustup.rs -sSf | \
		RUSTUP_HOME=$(RUSTUP_HOME) CARGO_HOME=$(CARGO_HOME) \
		sh -s -- -y --no-modify-path; \
	fi
	# Clone librespot source
	if [ ! -d librespot-source ]; then \
		git clone https://github.com/librespot-org/librespot.git librespot-source; \
	fi
	# Checkout specific commit or version
	cd librespot-source && \
	if [ -n "$(LIBRESPOT_COMMIT_ID)" ]; then \
		echo "Checking out commit: $(LIBRESPOT_COMMIT_ID)"; \
		git checkout $(LIBRESPOT_COMMIT_ID); \
	else \
		echo "Checking out version: $(LIBRESPOT_VERSION)"; \
		git checkout $(LIBRESPOT_VERSION); \
	fi
	# Create space-optimized Cargo config
	mkdir -p librespot-source/.cargo; \
	echo '[profile.release]' > librespot-source/.cargo/config.toml; \
	echo 'opt-level = "s"' >> librespot-source/.cargo/config.toml; \
	echo 'lto = true' >> librespot-source/.cargo/config.toml; \
	echo 'codegen-units = 1' >> librespot-source/.cargo/config.toml; \
	echo 'panic = "abort"' >> librespot-source/.cargo/config.toml; \
	echo 'strip = true' >> librespot-source/.cargo/config.toml; \
	echo '[build]' >> librespot-source/.cargo/config.toml; \
	echo 'jobs = 1' >> librespot-source/.cargo/config.toml; \
	echo 'target-dir = "target"' >> librespot-source/.cargo/config.toml

override_dh_auto_build:
	# Create isolated build directories
	mkdir -p $(CURDIR)/build_workspace/tmp $(CURDIR)/build_workspace/home; \
	# Clean any existing build artifacts first
	rm -rf $(CURDIR)/librespot-source/target/* 2>/dev/null || true; \
	# Create a minimal build script that forces all paths
	echo '#!/bin/bash' > $(CURDIR)/build.sh; \
	echo 'set -e' >> $(CURDIR)/build.sh; \
	echo 'cd "$(CURDIR)/librespot-source"' >> $(CURDIR)/build.sh; \
	echo 'export TMPDIR="$(CURDIR)/build_workspace/tmp"' >> $(CURDIR)/build.sh; \
	echo 'export HOME="$(CURDIR)/build_workspace/home"' >> $(CURDIR)/build.sh; \
	echo 'export CARGO_TARGET_DIR="$(CURDIR)/librespot-source/target"' >> $(CURDIR)/build.sh; \
	echo 'export CARGO_BUILD_INCREMENTAL=false' >> $(CURDIR)/build.sh; \
	echo 'export CARGO_BUILD_JOBS=1' >> $(CURDIR)/build.sh; \
	echo 'export RUST_BACKTRACE=0' >> $(CURDIR)/build.sh; \
	echo 'export PATH="$(CARGO_HOME)/bin:$$PATH"' >> $(CURDIR)/build.sh; \
	echo 'echo "Using TMPDIR: $$TMPDIR"' >> $(CURDIR)/build.sh; \
	echo 'echo "Using HOME: $$HOME"' >> $(CURDIR)/build.sh; \
	echo 'echo "Using CARGO_TARGET_DIR: $$CARGO_TARGET_DIR"' >> $(CURDIR)/build.sh; \
	echo 'exec cargo build --release --jobs 1 --no-default-features --features "rodio-backend alsa-backend with-avahi native-tls"' >> $(CURDIR)/build.sh; \
	chmod +x $(CURDIR)/build.sh; \
	# Run the build script
	$(CURDIR)/build.sh; \
	# Clean up intermediate files
	find $(CURDIR)/librespot-source/target -name "*.rlib" -delete 2>/dev/null || true; \
	find $(CURDIR)/librespot-source/target -name "*.rmeta" -delete 2>/dev/null || true; \
	rm -rf $(CURDIR)/build_workspace $(CURDIR)/build.sh

override_dh_auto_install:
	# Install librespot binary
	mkdir -p debian/hifiberry-librespot/usr/bin
	cp librespot-source/target/release/librespot debian/hifiberry-librespot/usr/bin/
	strip debian/hifiberry-librespot/usr/bin/librespot
	
	# Install helper scripts without .sh extension
	cp start-librespot.sh debian/hifiberry-librespot/usr/bin/start-librespot
	cp spotify-event.sh debian/hifiberry-librespot/usr/bin/spotify-event
	chmod +x debian/hifiberry-librespot/usr/bin/*
	
	# Install systemd user service
	mkdir -p debian/hifiberry-librespot/usr/lib/systemd/user
	cp librespot.service debian/hifiberry-librespot/usr/lib/systemd/user/
	
	# Install icon for player registry
	mkdir -p debian/hifiberry-librespot/usr/share/hifiberry-librespot/icons
	cp icons/spotify.svg debian/hifiberry-librespot/usr/share/hifiberry-librespot/icons/

	# Install man pages
	mkdir -p debian/hifiberry-librespot/usr/share/man/man1
	cp debian/librespot.1 debian/hifiberry-librespot/usr/share/man/man1/
	cp debian/start-librespot.1 debian/hifiberry-librespot/usr/share/man/man1/
	cp debian/spotify-event.1 debian/hifiberry-librespot/usr/share/man/man1/

	# Install the ACR player definition
	mkdir -p debian/hifiberry-librespot/etc/audiocontrol/players.d
	cp players.d/librespot.json debian/hifiberry-librespot/etc/audiocontrol/players.d/

	# WebUI player descriptor and its icon. Distinct from the ACR definition
	# above: different schema, different directory. These were never packaged --
	# dpkg -S found no owner for them on a running device -- so the player
	# appeared in the WebUI only where someone had placed the files by hand.
	# Now that this package is an extension that matters: one that installs
	# without registering a player is invisible.
	mkdir -p debian/hifiberry-librespot/etc/hifiberry/players.d/icons
	cp ui-players.d/librespot.json debian/hifiberry-librespot/etc/hifiberry/players.d/
	cp ui-players.d/icons/librespot.svg debian/hifiberry-librespot/etc/hifiberry/players.d/icons/

override_dh_auto_test:
	# Skip tests - requires network access and specific hardware

override_dh_strip:
	# Disable debug symbol generation completely
	dh_strip --no-automatic-dbgsym
	# Also remove any debug directories that might have been created
	rm -rf $(CURDIR)/debian/hifiberry-librespot/usr/lib/debug
