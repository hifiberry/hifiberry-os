#!/bin/bash
set -e

# For a user service, no system user or system directories are needed.
# Leave any runtime setup to the user session startup script.

case "$1" in
    configure)
        # Register in Web UI player registry
        HBOS_PLAYERS_D="/etc/hifiberry/players.d"
        mkdir -p "$HBOS_PLAYERS_D/icons"

        cat > "$HBOS_PLAYERS_D/librespot.json" <<'PLAYEREOF'
{
    "name": "Spotify",
    "provided_by": "librespot",
    "systemd_service": "librespot",
    "icon": "librespot",
    "allow_change": true,
    "maintainer_name": "Wanted",
    "maintainer_url": "https://github.com/hifiberry/hifiberry-os/blob/hbosng/docs/maintainers-wanted.md"
}
PLAYEREOF

        # Install icon
        if [ -f /usr/share/hifiberry-librespot/icons/spotify.svg ]; then
            cp /usr/share/hifiberry-librespot/icons/spotify.svg "$HBOS_PLAYERS_D/icons/librespot.svg"
        fi

        echo "Registered Spotify in Web UI player registry."

        # Register systemd permissions via configserver drop-in
        mkdir -p /etc/configserver/conf.d
        cat > /etc/configserver/conf.d/librespot.json <<'CONFEOF'
{
    "systemd": {
        "librespot": "all"
    }
}
CONFEOF

        echo "Configserver drop-in installed for librespot."

        # Register with ACR
        if [ -d /etc/audiocontrol ]; then
            ACR_PLAYERS_D="/etc/audiocontrol/players.d"
            mkdir -p "$ACR_PLAYERS_D"
            cat > "$ACR_PLAYERS_D/librespot.json" <<'ACREOF'
{
    "librespot": {
        "name": "librespot",
        "enable": true,
        "supports_api_events": true,
        "capabilities": ["killable"]
    }
}
ACREOF
            echo "Registered librespot with ACR."

            # The player is now provided via the players.d drop-in above. Remove any
            # stale inline "librespot" definition from the main audiocontrol config so
            # the player is not loaded twice.
            ACR_MAIN="/etc/audiocontrol/audiocontrol.json"
            if [ -f "$ACR_MAIN" ] && command -v python3 >/dev/null 2>&1; then
                python3 - "$ACR_MAIN" librespot <<'PYEOF'
import json, os, sys
path, key = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        data = json.load(f)
    players = data.get("players") if isinstance(data, dict) else None
    if isinstance(players, list):
        kept = [p for p in players if not (isinstance(p, dict) and key in p)]
        if len(kept) != len(players):
            data["players"] = kept
            tmp = path + ".acrtmp"
            with open(tmp, "w") as out:
                json.dump(data, out, indent=4)
                out.write("\n")
            os.replace(tmp, path)
            print("Removed stale inline '%s' player from audiocontrol.json" % key)
except Exception as e:
    sys.stderr.write("audiocontrol inline cleanup skipped: %s\n" % e)
sys.exit(0)
PYEOF
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        # No actions needed for user service during these states
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
