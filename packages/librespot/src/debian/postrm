#!/bin/bash
set -e

case "$1" in
    purge)
        # No system users or system directories to remove for user service
        :
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        :
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
