#!/bin/bash
set -e

case "$1" in
    remove)
        # Remove player registry files
        rm -f /etc/hifiberry/players.d/librespot.json
        rm -f /etc/hifiberry/players.d/icons/librespot.svg
        # Remove configserver drop-in
        rm -f /etc/configserver/conf.d/librespot.json
        # Registered conffile: dpkg decides its fate. Leave it in place on
        # remove so local edits survive a remove/reinstall cycle; it is
        # deleted on purge below.
        ;;
    purge)
        # Remove player registry files
        rm -f /etc/hifiberry/players.d/librespot.json
        rm -f /etc/hifiberry/players.d/icons/librespot.svg
        # Remove configserver drop-in
        rm -f /etc/configserver/conf.d/librespot.json
        # Registered conffile: only purge removes it.
        rm -f /etc/audiocontrol/players.d/librespot.json
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        :
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
