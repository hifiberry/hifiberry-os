[Unit]
Description=Librespot Spotify Connect Player
# Audiocontrol provides the Spotify access token
After=network-online.target sound.target avahi-daemon.service audiocontrol.service
Wants=network-online.target

[Service]
Type=simple
User=librespot
Group=audio
Environment=RUST_BACKTRACE=1
ExecStart=/usr/bin/start-librespot
Restart=always
RestartSec=10
StartLimitInterval=30
StartLimitBurst=5

[Install]
WantedBy=multi-user.target