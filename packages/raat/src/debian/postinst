#!/bin/bash

set -e

case "$1" in
    configure)
        # For user service deployments, no system user is required.
        # Keep legacy user creation for compatibility if unit is used system-wide.
        if systemctl status raat.service >/dev/null 2>&1 && [ -d /usr/lib/systemd/system ]; then
            if ! getent group raat >/dev/null; then
                addgroup --system raat
            fi
            if ! getent passwd raat >/dev/null; then
                adduser --system --ingroup raat --home /var/lib/raat --shell /bin/false raat
            fi
            if getent group gpio >/dev/null; then
                usermod -a -G gpio raat || true
            fi
            if getent group audio >/dev/null; then
                usermod -a -G audio raat || true
            fi
            mkdir -p /var/lib/raat
            chown raat:raat /var/lib/raat
            chmod 755 /var/lib/raat
        else
            # For user service deployments, create /var/lib/raat with audio group access
            # This is needed for metadata pipe functionality even in user service mode
            mkdir -p /var/lib/raat
            if getent group audio >/dev/null; then
                chgrp audio /var/lib/raat
                chmod 775 /var/lib/raat
            else
                chmod 755 /var/lib/raat
            fi
        fi
        ;;
esac

#DEBHELPER#

# raat.service runs as a systemd *user* service of the HiFiBerry user,
# and debhelper only restarts system services on upgrade. Without this, an
# upgrade leaves the old code running until the next reboot or login.
# try-restart, so a service that is not running -- a player switched off in
# the WebUI, or a fresh install -- is not started by this. Best effort; a
# no-op during image builds, where no user manager runs.
user_systemctl() {
    [ -d /run/systemd/system ] || return 0
    [ -f /etc/hifiberry.user ] || return 0
    HB_USER=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$' /etc/hifiberry.user | head -1 | tr -d '[:space:]')
    [ -n "$HB_USER" ] && getent passwd "$HB_USER" >/dev/null 2>&1 || return 0
    HB_UID=$(id -u "$HB_USER" 2>/dev/null) || return 0
    [ -d "/run/user/$HB_UID" ] || return 0
    systemd-run --uid "$HB_UID" --setenv XDG_RUNTIME_DIR="/run/user/$HB_UID" \
        --pipe --wait --quiet --collect \
        systemctl --user "$@" >/dev/null 2>&1 || true
}

if [ "$1" = "configure" ]; then
    user_systemctl daemon-reload
    user_systemctl try-restart raat.service
fi

exit 0
