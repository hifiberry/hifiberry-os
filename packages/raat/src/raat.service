[Unit]
Description=Roon
After=sound.target pipewire.service
Wants=sound.target
ConditionPathExists=/etc/uuid

[Service]
Type=simple
ExecStart=/usr/bin/start-raat
StandardOutput=journal
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=raat

[Install]
WantedBy=default.target
