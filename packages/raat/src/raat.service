[Unit]
Description=Roon
After=pipewire.service
ConditionPathExists=/etc/uuid

[Service]
Type=simple
ExecStart=/usr/bin/start-raat
StandardOutput=journal
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=raat

[Install]
WantedBy=default.target
