#!/bin/bash
# HiFiBerry 16-Band EQ Control Script
# Controls the biquad filters in the inserted EQ filter chain

show_usage() {
    echo "HiFiBerry 16-Band EQ Control"
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Commands:"
    echo "  set-band <band> <type> <freq> <q> <gain>"
    echo "    band: 1-16"
    echo "    type: lowpass, highpass, bandpass, lowshelf, highshelf, peaking, notch, allpass, none"
    echo "    freq: frequency in Hz"
    echo "    q: Q factor (0.1-30.0)"  
    echo "    gain: gain in dB (-20.0 to +20.0)"
    echo ""
    echo "  disable-band <band>"
    echo "    Disable a specific band (set to passthrough)"
    echo ""
    echo "  reset"
    echo "    Reset all bands to passthrough (disable EQ)"
    echo ""
    echo "  show"
    echo "    Show current EQ settings"
    echo ""
    echo "Examples:"
    echo "  $0 set-band 1 highpass 80 0.7 0      # High-pass at 80Hz"
    echo "  $0 set-band 5 peaking 1000 2.0 3.5   # +3.5dB peak at 1kHz"
    echo "  $0 set-band 10 lowpass 8000 1.0 0    # Low-pass at 8kHz"
    echo "  $0 disable-band 3                    # Disable band 3"
    echo "  $0 reset                             # Reset all bands"
}

get_filter_id() {
    local filter_id=$(pw-cli ls Node | grep -A5 "hifiberry-eq-filter" | grep "id:" | cut -d: -f2 | tr -d ' ')
    
    if [ -z "$filter_id" ]; then
        echo "Error: HiFiBerry EQ filter not found" >&2
        return 1
    fi
    echo "$filter_id"
}

set_biquad() {
    local band="$1"
    local btype="$2" 
    local freq="$3"
    local q="$4"
    local gain="$5"
    
    # Validate band number
    if [ "$band" -lt 1 ] || [ "$band" -gt 16 ]; then
        echo "Error: Band must be between 1 and 16" >&2
        return 1
    fi
    
    # Format band number with leading zero
    local band_name=$(printf "bq%02d" "$band")
    
    local filter_id
    filter_id=$(get_filter_id) || return 1
    
    echo "Setting band $band ($band_name): $btype $freq Hz, Q=$q, Gain=${gain}dB"
    
    pw-cli set-param "$filter_id" Props "{
        filter.graph.nodes.$band_name.config.biquad.type = \"$btype\",
        filter.graph.nodes.$band_name.config.biquad.freq = $freq,
        filter.graph.nodes.$band_name.config.biquad.q = $q,
        filter.graph.nodes.$band_name.config.biquad.gain = $gain
    }"
}

disable_band() {
    local band="$1"
    
    if [ "$band" -lt 1 ] || [ "$band" -gt 16 ]; then
        echo "Error: Band must be between 1 and 16" >&2
        return 1
    fi
    
    echo "Disabling band $band"
    set_biquad "$band" "none" 1000 1.0 0.0
}

reset_eq() {
    echo "Resetting all EQ bands to passthrough"
    for i in $(seq 1 16); do
        set_biquad "$i" "none" 1000 1.0 0.0
    done
}

show_eq() {
    local filter_id
    filter_id=$(get_filter_id) || return 1
    
    echo "HiFiBerry 16-Band EQ Status (Node ID: $filter_id)"
    echo "Band | Type      | Freq    | Q    | Gain"
    echo "-----|-----------|---------|------|------"
    
    # This would require parsing pw-cli output - simplified version
    echo "Use 'pw-cli e $filter_id Props' for detailed filter parameters"
}

# Main execution
case "$1" in
    "set-band")
        if [ $# -ne 6 ]; then
            echo "Error: set-band requires 5 parameters" >&2
            show_usage
            exit 1
        fi
        set_biquad "$2" "$3" "$4" "$5" "$6"
        ;;
    "disable-band")
        if [ $# -ne 2 ]; then
            echo "Error: disable-band requires band number" >&2
            show_usage
            exit 1
        fi
        disable_band "$2"
        ;;
    "reset")
        reset_eq
        ;;
    "show")
        show_eq
        ;;
    "")
        show_usage
        exit 1
        ;;
    *)
        echo "Error: Unknown command '$1'" >&2
        show_usage
        exit 1
        ;;
esac
