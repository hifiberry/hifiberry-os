#!/bin/bash

# HiFiBerry Bluetooth Audio PIN Configuration Helper

CONFIG_FILE="/etc/hifiberry/btaudio.conf"
TEMP_FILE=$(mktemp)

show_help() {
    echo "HiFiBerry Bluetooth Audio PIN Configuration"
    echo ""
    echo "Usage: $0 [options]"
    echo ""
    echo "Options:"
    echo "  --set-pin PIN     Set PIN code (4-8 digits)"
    echo "  --remove-pin      Remove PIN code (use passkey confirmation)"
    echo "  --show-pin        Show current PIN setting"
    echo "  --help            Show this help"
    echo ""
    echo "Examples:"
    echo "  $0 --set-pin 1234     # Set PIN to 1234"
    echo "  $0 --remove-pin       # Remove PIN, use passkey confirmation"
    echo "  $0 --show-pin         # Show current PIN setting"
}

set_pin() {
    local pin="$1"
    
    # Validate PIN
    if [[ ! "$pin" =~ ^[0-9]{4,8}$ ]]; then
        echo "Error: PIN must be 4-8 digits"
        exit 1
    fi
    
    # Create config directory if it doesn't exist
    mkdir -p "$(dirname "$CONFIG_FILE")"
    
    # Update config file
    if [[ -f "$CONFIG_FILE" ]]; then
        # Replace existing PIN line or add new one
        if grep -q "^bluetooth\.pin=" "$CONFIG_FILE"; then
            sed "s/^bluetooth\.pin=.*/bluetooth.pin=$pin/" "$CONFIG_FILE" > "$TEMP_FILE"
        else
            cp "$CONFIG_FILE" "$TEMP_FILE"
            echo "bluetooth.pin=$pin" >> "$TEMP_FILE"
        fi
    else
        # Create new config file with PIN
        echo "bluetooth.pin=$pin" > "$TEMP_FILE"
    fi
    
    mv "$TEMP_FILE" "$CONFIG_FILE"
    chmod 644 "$CONFIG_FILE"
    
    echo "PIN set to: $pin"
    echo "Restart hifiberry-btaudio service for changes to take effect:"
    echo "  systemctl restart hifiberry-btaudio"
}

remove_pin() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # Remove PIN line or set it to empty
        if grep -q "^bluetooth\.pin=" "$CONFIG_FILE"; then
            sed "s/^bluetooth\.pin=.*/bluetooth.pin=/" "$CONFIG_FILE" > "$TEMP_FILE"
            mv "$TEMP_FILE" "$CONFIG_FILE"
            echo "PIN removed - will use passkey confirmation"
        else
            echo "No PIN was set"
        fi
    else
        echo "No configuration file found"
    fi
    
    echo "Restart hifiberry-btaudio service for changes to take effect:"
    echo "  systemctl restart hifiberry-btaudio"
}

show_pin() {
    if [[ -f "$CONFIG_FILE" ]]; then
        local pin=$(grep "^bluetooth\.pin=" "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2)
        if [[ -n "$pin" ]]; then
            echo "Current PIN: $pin"
        else
            echo "No PIN set - using passkey confirmation"
        fi
    else
        echo "No configuration file found - no PIN set"
    fi
}

# Main script
case "$1" in
    --set-pin)
        if [[ -z "$2" ]]; then
            echo "Error: PIN required"
            echo "Usage: $0 --set-pin PIN"
            exit 1
        fi
        set_pin "$2"
        ;;
    --remove-pin)
        remove_pin
        ;;
    --show-pin)
        show_pin
        ;;
    --help|"")
        show_help
        ;;
    *)
        echo "Error: Unknown option $1"
        show_help
        exit 1
        ;;
esac

# Cleanup
rm -f "$TEMP_FILE"
