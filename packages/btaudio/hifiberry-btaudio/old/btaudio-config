                                      capture_output=True, text=True, timeout=10)
                if result.returncode == 0:
                    print("✓ Discoverable mode enabled")
                    success_count += 1
                else:
                    print(f"⚠ Could not enable discoverable mode: {result.stderr.strip()}")
            except Exception as e:
                print(f"⚠ Could not enable discoverable mode: {e}")
            
            # Enable pairable mode
            print("Enabling pairable mode...")
            total_operations += 1
            try:
                result = subprocess.run(['bluetoothctl', 'pairable', 'on'], 
                                      capture_output=True, text=True, timeout=10)
                if result.returncode == 0:
                    print("✓ Pairable mode enabled")
                    success_count += 1
                else:
                    print(f"⚠ Could not enable pairable mode: {result.stderr.strip()}")
            except Exception as e:
                print(f"⚠ Could not enable pairable mode: {e}")
            
