            if success_count < total_operations:
                print("⚠ Some operations failed, but basic functionality should work")
            
            print("")
            print("IMPORTANT: Device class and audio UUIDs are managed by:")
            print("  1. BlueZ configuration (/etc/bluetooth/main.conf)")
            print("  2. Audio backend (PipeWire/PulseAudio) with Bluetooth modules")
