                result = subprocess.run(['bluetoothctl', 'system-alias', device_name], 
                                      capture_output=True, text=True, timeout=10)
                if result.returncode == 0:
                    print(f"✓ Device name set to '{device_name}'")
                    success_count += 1
                else:
