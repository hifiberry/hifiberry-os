#!/usr/bin/env python3
"""
HiFiBerry Bluetooth Audio Discoverable Service
Makes the system discoverable for Bluetooth audio senders like iPhones
"""

import sys
import time
import signal
import socket
import subprocess
import os
import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib

class BluetoothAgent(dbus.service.Object):
    """Bluetooth pairing agent for handling secure pairing"""
    
    def __init__(self, bus, path, pin_code=None):
        super().__init__(bus, path)
        self.pin_code = pin_code
        self.bus = bus
    
    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def RequestPinCode(self, device, message):
        """Request PIN code for legacy devices"""
        if self.pin_code:
            print(f"Using configured PIN for device: {device}")
            return self.pin_code
        else:
            print(f"PIN requested for device: {device} - auto-rejecting (no PIN configured)")
            raise dbus.exceptions.DBusException("org.bluez.Error.Rejected", "No PIN configured")
    
    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPasskey(self, device):
        """Request passkey for devices that support it"""
        if self.pin_code and self.pin_code.isdigit():
            print(f"Using configured passkey for device: {device}")
            return dbus.UInt32(int(self.pin_code))
        else:
            print(f"Passkey requested for device: {device} - auto-rejecting (no PIN configured)")
            raise dbus.exceptions.DBusException("org.bluez.Error.Rejected", "No valid passkey configured")
    
    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def DisplayPasskey(self, device, passkey):
        """Display passkey for verification"""
        print(f"Passkey for {device}: {passkey:06d}")
    
    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pin_code):
        """Display PIN code for verification"""
        print(f"PIN code for {device}: {pin_code}")
    
    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        """Request confirmation of passkey"""
        print(f"Auto-confirming passkey {passkey:06d} for device: {device}")
        # Auto-confirm for audio devices
        return
    
    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        """Request authorization for connection"""
        print(f"Auto-authorizing connection from: {device}")
        # Auto-authorize for audio devices
        return
    
    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        """Cancel pairing operation"""
        print("Pairing operation cancelled")

class BluetoothDiscoverableService:
    def __init__(self):
        self.bus = dbus.SystemBus()
        self.adapter = None
        self.mainloop = None
        self.running = True
        self.agent = None
        self.agent_path = "/hifiberry/bluetooth/agent"
        
        # Setup signal handlers
        signal.signal(signal.SIGTERM, self.signal_handler)
        signal.signal(signal.SIGINT, self.signal_handler)
        
        self.find_adapter()
    
    def load_pin_from_config(self):
        """Load PIN code from configuration file"""
        try:
            config_file = "/etc/hifiberry/btaudio.conf"
            if os.path.exists(config_file):
                with open(config_file, 'r') as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith('bluetooth.pin='):
                            pin = line.split('=', 1)[1].strip()
                            if pin and pin.isdigit() and 4 <= len(pin) <= 8:
                                return pin
        except Exception as e:
            print(f"Error reading PIN from config: {e}")
        return None
    
    def get_device_name(self):
        """Get the device name from hostname or pretty hostname"""
        try:
            # Try to get pretty hostname first
            result = subprocess.run(['hostnamectl', '--pretty'], 
                                  capture_output=True, text=True, timeout=5)
            if result.returncode == 0 and result.stdout.strip():
                pretty_hostname = result.stdout.strip()
                if pretty_hostname and pretty_hostname != "":
                    return pretty_hostname
        except (subprocess.TimeoutExpired, subprocess.CalledProcessError, FileNotFoundError):
            pass
        
        try:
            # Fall back to regular hostname
            hostname = socket.gethostname()
            if hostname:
                return hostname
        except Exception:
            pass
        
        # Final fallback
        return "HiFiBerry Audio"
    
    def signal_handler(self, signum, frame):
        """Handle shutdown signals"""
        print(f"Received signal {signum}, shutting down...")
        self.running = False
        if self.mainloop:
            self.mainloop.quit()
    
    def find_adapter(self):
        """Find the Bluetooth adapter"""
        try:
            manager = dbus.Interface(self.bus.get_object("org.bluez", "/"), 
                                   "org.freedesktop.DBus.ObjectManager")
            objects = manager.GetManagedObjects()
            
            for path, interfaces in objects.items():
                if "org.bluez.Adapter1" in interfaces:
                    self.adapter = dbus.Interface(self.bus.get_object("org.bluez", path), 
                                                "org.bluez.Adapter1")
                    self.adapter_path = path
                    print(f"Found Bluetooth adapter: {path}")
                    return True
            
            print("No Bluetooth adapter found")
            return False
            
        except Exception as e:
            print(f"Error finding adapter: {e}")
            return False
    
    def setup_secure_pairing(self):
        """Setup secure pairing agent"""
        try:
            # Load PIN from config if available
            pin_code = self.load_pin_from_config()
            
            # Create and register agent
            self.agent = BluetoothAgent(self.bus, self.agent_path, pin_code)
            
            # Get agent manager
            agent_manager = dbus.Interface(self.bus.get_object("org.bluez", "/org/bluez"),
                                         "org.bluez.AgentManager1")
            
            # Register agent
            if pin_code:
                # Use DisplayOnly mode for PIN-based pairing
                agent_manager.RegisterAgent(self.agent_path, "DisplayOnly")
                print(f"Secure pairing enabled with PIN: {pin_code}")
            else:
                # Use DisplayYesNo for passkey confirmation
                agent_manager.RegisterAgent(self.agent_path, "DisplayYesNo")
                print("Secure pairing enabled with passkey confirmation")
            
            agent_manager.RequestDefaultAgent(self.agent_path)
            return True
            
        except Exception as e:
            print(f"Error setting up secure pairing: {e}")
            return False
    
    def setup_audio_sink(self):
        """Configure the system as a Bluetooth audio sink"""
        if not self.adapter:
            return False
        
        try:
            props = dbus.Interface(self.adapter, "org.freedesktop.DBus.Properties")
            
            # Get device name
            device_name = self.get_device_name()
            
            # Enable the adapter
            props.Set("org.bluez.Adapter1", "Powered", dbus.Boolean(True))
            print("Bluetooth adapter powered on")
            
            # Set discoverable
            props.Set("org.bluez.Adapter1", "Discoverable", dbus.Boolean(True))
            print("Bluetooth adapter set to discoverable")
            
            # Set discoverable timeout to 0 (infinite)
            props.Set("org.bluez.Adapter1", "DiscoverableTimeout", dbus.UInt32(0))
            
            # Set pairable
            props.Set("org.bluez.Adapter1", "Pairable", dbus.Boolean(True))
            print("Bluetooth adapter set to pairable")
            
            # Set device name
            props.Set("org.bluez.Adapter1", "Alias", dbus.String(device_name))
            print(f"Device name set to '{device_name}'")
            
            # Set device class for audio device (0x200414 = Audio/Video, Audio sink)
            # This helps devices like iPhones recognize it as an audio device
            try:
                props.Set("org.bluez.Adapter1", "Class", dbus.UInt32(0x200414))
                print("Device class set to audio sink")
            except Exception as e:
                print(f"Note: Could not set device class: {e}")
            
            # Setup secure pairing
            if self.setup_secure_pairing():
                print("Secure pairing agent configured")
            else:
                print("Warning: Could not setup secure pairing agent")
            
            print(f"HiFiBerry is now discoverable as a Bluetooth audio sink: '{device_name}'")
            return True
            
        except Exception as e:
            print(f"Error setting up audio sink: {e}")
            return False
    
    def monitor_connections(self):
        """Monitor for new Bluetooth connections"""
        def device_added(path, interfaces):
            if "org.bluez.Device1" in interfaces:
                device_props = interfaces["org.bluez.Device1"]
                if "Address" in device_props:
                    address = device_props["Address"]
                    name = device_props.get("Name", "Unknown")
                    print(f"New device detected: {name} ({address})")
        
        def device_removed(path, interfaces):
            if "org.bluez.Device1" in interfaces:
                print(f"Device removed: {path}")
        
        # Listen for device additions/removals
        manager = dbus.Interface(self.bus.get_object("org.bluez", "/"), 
                               "org.freedesktop.DBus.ObjectManager")
        manager.connect_to_signal("InterfacesAdded", device_added)
        manager.connect_to_signal("InterfacesRemoved", device_removed)
    
    def run(self):
        """Main service loop"""
        if not self.setup_audio_sink():
            sys.exit(1)
        
        # Setup connection monitoring
        self.monitor_connections()
        
        # Run the main loop
        self.mainloop = GLib.MainLoop()
        
        print("HiFiBerry Bluetooth Audio service started")
        print(f"System is discoverable as '{self.get_device_name()}'")
        print("Press Ctrl+C to stop")
        
        try:
            self.mainloop.run()
        except KeyboardInterrupt:
            print("\nService interrupted")
        
        print("HiFiBerry Bluetooth Audio service stopped")

def main():
    # Setup DBus main loop
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    
    # Create and run the service
    service = BluetoothDiscoverableService()
    service.run()

if __name__ == "__main__":
    main()
