#!/usr/bin/env python3
"""
HiFiBerry Bluetooth Audio Configuration Tool
"""

import sys
import subprocess
import argparse
import time
import socket
import os
import random
import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib

class BluetoothAgent(dbus.service.Object):
    """Bluetooth pairing agent for handling PIN codes and secure pairing"""
    
    def __init__(self, bus, path, pin_code=None):
        super().__init__(bus, path)
        self.pin_code = pin_code
        self.bus = bus
    
    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def RequestPinCode(self, device, message):
        """Request PIN code for legacy devices"""
        if self.pin_code:
            print(f"Using configured PIN for device: {device}")
            return self.pin_code
        else:
            print(f"PIN requested for device: {device}")
            print("No PIN configured, rejecting pairing")
            raise dbus.exceptions.DBusException("org.bluez.Error.Rejected", "No PIN configured")
    
    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPasskey(self, device):
        """Request passkey for devices that support it"""
        if self.pin_code and self.pin_code.isdigit():
            print(f"Using configured passkey for device: {device}")
            return dbus.UInt32(int(self.pin_code))
        else:
            print(f"Passkey requested for device: {device}")
            print("No valid numeric PIN configured, rejecting pairing")
            raise dbus.exceptions.DBusException("org.bluez.Error.Rejected", "No valid passkey configured")
    
    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def DisplayPasskey(self, device, passkey):
        """Display passkey for verification"""
        print(f"Passkey for {device}: {passkey:06d}")
        print("Confirm this passkey on the connecting device")
    
    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pin_code):
        """Display PIN code for verification"""
        print(f"PIN code for {device}: {pin_code}")
        print("Enter this PIN code on the connecting device")
    
    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        """Request confirmation of passkey"""
        print(f"Confirm passkey {passkey:06d} for device: {device}")
        print("Auto-confirming for HiFiBerry Audio...")
        # Auto-confirm for audio devices to avoid user interaction
        return
    
    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        """Request authorization for connection"""
        print(f"Authorizing connection from: {device}")
        # Auto-authorize for audio devices
        return
    
    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        """Cancel pairing operation"""
        print("Pairing operation cancelled")

class BluetoothManager:
    def __init__(self):
        self.bus = dbus.SystemBus()
        self.adapter = None
        self.agent_path = "/hifiberry/bluetooth/agent"
        self.agent = None
        self.find_adapter()
    
    def get_device_name(self):
        """Get the device name from hostname or pretty hostname"""
        try:
            # Try to get pretty hostname first
            result = subprocess.run(['hostnamectl', '--pretty'], 
                                  capture_output=True, text=True, timeout=5)
            if result.returncode == 0 and result.stdout.strip():
                pretty_hostname = result.stdout.strip()
                if pretty_hostname and pretty_hostname != "":
                    return pretty_hostname
        except (subprocess.TimeoutExpired, subprocess.CalledProcessError, FileNotFoundError):
            pass
        
        try:
            # Fall back to regular hostname
            hostname = socket.gethostname()
            if hostname:
                return hostname
        except Exception:
            pass
        
        # Final fallback
        return "HiFiBerry Audio"
    
    def load_pin_from_config(self):
        """Load PIN code from configuration file"""
        try:
            config_file = "/etc/hifiberry/btaudio.conf"
            if os.path.exists(config_file):
                with open(config_file, 'r') as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith('bluetooth.pin='):
                            pin = line.split('=', 1)[1].strip()
                            if pin and pin.isdigit() and 4 <= len(pin) <= 8:
                                return pin
        except Exception as e:
            print(f"Error reading PIN from config: {e}")
        return None
    
    def save_pin_to_config(self, pin_code):
        """Save PIN code to configuration file"""
        try:
            config_file = "/etc/hifiberry/btaudio.conf"
            temp_file = config_file + ".tmp"
            
            # Ensure directory exists
            os.makedirs(os.path.dirname(config_file), exist_ok=True)
            
            # Read existing config or create new
            lines = []
            if os.path.exists(config_file):
                with open(config_file, 'r') as f:
                    lines = f.readlines()
            
            # Update or add PIN line
            pin_line_found = False
            for i, line in enumerate(lines):
                if line.strip().startswith('bluetooth.pin='):
                    lines[i] = f"bluetooth.pin={pin_code}\n"
                    pin_line_found = True
                    break
            
            if not pin_line_found:
                lines.append(f"bluetooth.pin={pin_code}\n")
            
            # Write to temp file then move
            with open(temp_file, 'w') as f:
                f.writelines(lines)
            
            os.rename(temp_file, config_file)
            os.chmod(config_file, 0o644)
            return True
            
        except Exception as e:
            print(f"Error saving PIN to config: {e}")
            return False
    
    def generate_random_pin(self):
        """Generate a random 4-digit PIN"""
        return f"{random.randint(1000, 9999)}"
    
    def find_adapter(self):
        """Find the Bluetooth adapter"""
        try:
            manager = dbus.Interface(self.bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager")
            objects = manager.GetManagedObjects()
            
            for path, interfaces in objects.items():
                if "org.bluez.Adapter1" in interfaces:
                    self.adapter = dbus.Interface(self.bus.get_object("org.bluez", path), "org.bluez.Adapter1")
                    self.adapter_path = path
                    return True
            return False
        except Exception as e:
            print(f"Error finding adapter: {e}")
            return False
    
    def make_discoverable(self, timeout=0):
        """Make the adapter discoverable"""
        if not self.adapter:
            print("No Bluetooth adapter found")
            return False
        
        try:
            # Get device name
            device_name = self.get_device_name()
            
            # Enable the adapter
            self.adapter.Set("org.bluez.Adapter1", "Powered", dbus.Boolean(True))
            
            # Set device class for audio sink (0x200414 = Audio/Video + Major Audio + Audio Device)
            # This helps phones recognize the device as an audio sink
            try:
                self.adapter.Set("org.bluez.Adapter1", "Class", dbus.UInt32(0x200414))
                print("Set device class to Audio Sink")
            except Exception as e:
                print(f"Warning: Could not set device class: {e}")
            
            # Set discoverable
            self.adapter.Set("org.bluez.Adapter1", "Discoverable", dbus.Boolean(True))
            
            # Set discoverable timeout (0 = infinite)
            self.adapter.Set("org.bluez.Adapter1", "DiscoverableTimeout", dbus.UInt32(timeout))
            
            # Set pairable
            self.adapter.Set("org.bluez.Adapter1", "Pairable", dbus.Boolean(True))
            
            # Set device name
            self.adapter.Set("org.bluez.Adapter1", "Alias", dbus.String(device_name))
            
            # Enable A2DP profile support by ensuring proper UUIDs are advertised
            try:
                # A2DP Sink UUID: 0000110B-0000-1000-8000-00805F9B34FB
                # Audio Source UUID: 0000110A-0000-1000-8000-00805F9B34FB  
                # AVRCP Target UUID: 0000110C-0000-1000-8000-00805F9B34FB
                uuids = [
                    "0000110B-0000-1000-8000-00805F9B34FB",  # A2DP Sink
                    "0000110C-0000-1000-8000-00805F9B34FB",  # AVRCP Target
                    "0000111E-0000-1000-8000-00805F9B34FB",  # HFP HF (Hands-Free)
                ]
                self.adapter.Set("org.bluez.Adapter1", "UUIDs", dbus.Array(uuids, signature='s'))
                print("Configured audio profile UUIDs")
            except Exception as e:
                print(f"Warning: Could not set UUIDs: {e}")
            
            print(f"System is now discoverable as '{device_name}' (Audio Sink)")
            if timeout > 0:
                print(f"Discoverable for {timeout} seconds")
            else:
                print("Discoverable indefinitely")
            
            return True
            
        except Exception as e:
            print(f"Error making discoverable: {e}")
            return False
    
    def hide_discoverable(self):
        """Hide the adapter from discovery"""
        if not self.adapter:
            print("No Bluetooth adapter found")
            return False
        
        try:
            self.adapter.Set("org.bluez.Adapter1", "Discoverable", dbus.Boolean(False))
            print("System is no longer discoverable")
            return True
        except Exception as e:
            print(f"Error hiding discoverable: {e}")
            return False
    
    def get_status(self):
        """Get Bluetooth adapter status"""
        if not self.adapter:
            print("No Bluetooth adapter found")
            return
        
        try:
            props = dbus.Interface(self.adapter, "org.freedesktop.DBus.Properties")
            
            powered = props.Get("org.bluez.Adapter1", "Powered")
            discoverable = props.Get("org.bluez.Adapter1", "Discoverable")
            pairable = props.Get("org.bluez.Adapter1", "Pairable")
            alias = props.Get("org.bluez.Adapter1", "Alias")
            address = props.Get("org.bluez.Adapter1", "Address")
            
            print(f"Bluetooth Status:")
            print(f"  Address: {address}")
            print(f"  Name: {alias}")
            print(f"  Powered: {powered}")
            print(f"  Discoverable: {discoverable}")
            print(f"  Pairable: {pairable}")
            
        except Exception as e:
            print(f"Error getting status: {e}")
    
    def setup_secure_pairing(self, pin_code=None, pairing_mode="DisplayYesNo"):
        """Setup secure pairing with optional PIN code"""
        try:
            # Use provided PIN or load from config
            if pin_code is None:
                pin_code = self.load_pin_from_config()
            
            # Create and register agent
            self.agent = BluetoothAgent(self.bus, self.agent_path, pin_code)
            
            # Get agent manager
            agent_manager = dbus.Interface(self.bus.get_object("org.bluez", "/org/bluez"),
                                         "org.bluez.AgentManager1")
            
            # Register agent with specified capability
            agent_manager.RegisterAgent(self.agent_path, pairing_mode)
            agent_manager.RequestDefaultAgent(self.agent_path)
            
            if pin_code:
                print(f"Secure pairing enabled with PIN: {pin_code}")
            else:
                print(f"Secure pairing enabled with mode: {pairing_mode}")
            
            return True
            
        except Exception as e:
            print(f"Error setting up secure pairing: {e}")
            return False
    
    def remove_secure_pairing(self):
        """Remove secure pairing agent"""
        try:
            if self.agent:
                agent_manager = dbus.Interface(self.bus.get_object("org.bluez", "/org/bluez"),
                                             "org.bluez.AgentManager1")
                agent_manager.UnregisterAgent(self.agent_path)
                self.agent.remove_from_connection()
                self.agent = None
                print("Secure pairing disabled")
                return True
        except Exception as e:
            print(f"Error removing secure pairing: {e}")
            return False
    
    def list_paired_devices(self):
        """List all paired devices"""
        try:
            manager = dbus.Interface(self.bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager")
            objects = manager.GetManagedObjects()
            
            paired_devices = []
            for path, interfaces in objects.items():
                if "org.bluez.Device1" in interfaces:
                    device_props = interfaces["org.bluez.Device1"]
                    if device_props.get("Paired", False):
                        device_info = {
                            'path': path,
                            'address': device_props.get("Address", "Unknown"),
                            'name': device_props.get("Name", device_props.get("Alias", "Unknown")),
                            'connected': device_props.get("Connected", False),
                            'trusted': device_props.get("Trusted", False)
                        }
                        paired_devices.append(device_info)
            
            if paired_devices:
                print("Paired Bluetooth devices:")
                print("=" * 60)
                for device in paired_devices:
                    status_indicators = []
                    if device['connected']:
                        status_indicators.append("Connected")
                    if device['trusted']:
                        status_indicators.append("Trusted")
                    
                    status = f" ({', '.join(status_indicators)})" if status_indicators else ""
                    print(f"  {device['name']}")
                    print(f"    Address: {device['address']}{status}")
                    print()
            else:
                print("No paired devices found")
            
            return paired_devices
            
        except Exception as e:
            print(f"Error listing paired devices: {e}")
            return []
    
    def remove_device(self, device_address):
        """Remove (unpair) a device by MAC address"""
        try:
            manager = dbus.Interface(self.bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager")
            objects = manager.GetManagedObjects()
            
            device_path = None
            device_name = None
            
            # Find the device path
            for path, interfaces in objects.items():
                if "org.bluez.Device1" in interfaces:
                    device_props = interfaces["org.bluez.Device1"]
                    if device_props.get("Address", "").lower() == device_address.lower():
                        device_path = path
                        device_name = device_props.get("Name", device_props.get("Alias", "Unknown"))
                        break
            
            if not device_path:
                print(f"Device with address {device_address} not found")
                return False
            
            # Disconnect if connected
            try:
                device = dbus.Interface(self.bus.get_object("org.bluez", device_path), "org.bluez.Device1")
                device_props = dbus.Interface(device, "org.freedesktop.DBus.Properties")
                if device_props.Get("org.bluez.Device1", "Connected"):
                    print(f"Disconnecting {device_name}...")
                    device.Disconnect()
                    time.sleep(1)  # Give time for disconnection
            except Exception as e:
                print(f"Warning: Could not disconnect device: {e}")
            
            # Remove the device
            if self.adapter:
                adapter = dbus.Interface(self.bus.get_object("org.bluez", self.adapter_path), "org.bluez.Adapter1")
                adapter.RemoveDevice(device_path)
                print(f"Successfully removed device: {device_name} ({device_address})")
                return True
            else:
                print("No Bluetooth adapter found")
                return False
                
        except Exception as e:
            print(f"Error removing device {device_address}: {e}")
            return False
    
    def remove_all_devices(self):
        """Remove all paired devices"""
        try:
            paired_devices = self.list_paired_devices()
            if not paired_devices:
                print("No paired devices to remove")
                return True
            
            print(f"\nRemoving {len(paired_devices)} paired device(s)...")
            success_count = 0
            
            for device in paired_devices:
                if self.remove_device(device['address']):
                    success_count += 1
            
            print(f"\nSuccessfully removed {success_count} out of {len(paired_devices)} devices")
            return success_count == len(paired_devices)
            
        except Exception as e:
            print(f"Error removing all devices: {e}")
            return False
    
    def setup_audio_profiles(self):
        """Setup Bluetooth audio profiles for A2DP sink"""
        if not self.adapter:
            print("No Bluetooth adapter found")
            return False
        
        try:
            # Enable the adapter first
            self.adapter.Set("org.bluez.Adapter1", "Powered", dbus.Boolean(True))
            
            # Set device class for audio sink
            # Class 0x200414 = Service Class: Audio (bit 21), Major Device Class: Audio/Video (0x04), Minor: Loudspeaker (0x14)
            self.adapter.Set("org.bluez.Adapter1", "Class", dbus.UInt32(0x200414))
            
            # Set UUIDs for audio profiles
            uuids = [
                "0000110B-0000-1000-8000-00805F9B34FB",  # A2DP Sink
                "0000110C-0000-1000-8000-00805F9B34FB",  # AVRCP Target (media control)
                "0000111E-0000-1000-8000-00805F9B34FB",  # HFP HF (Hands-Free Profile)
            ]
            self.adapter.Set("org.bluez.Adapter1", "UUIDs", dbus.Array(uuids, signature='s'))
            
            print("Bluetooth audio profiles configured:")
            print("  - A2DP Sink (receive audio from phones)")
            print("  - AVRCP Target (media control)")
            print("  - Device Class: Audio Sink (0x200414)")
            print("")
            print("Your system should now appear as an audio device to phones/tablets")
            
            return True
            
        except Exception as e:
            print(f"Error setting up audio profiles: {e}")
            return False
    
    def check_audio_profiles(self):
        """Check current Bluetooth audio profile configuration"""
        if not self.adapter:
            print("No Bluetooth adapter found")
            return False
        
        try:
            props = dbus.Interface(self.adapter, "org.freedesktop.DBus.Properties")
            
            # Get current device class
            try:
                device_class = props.Get("org.bluez.Adapter1", "Class")
                device_class_hex = f"0x{device_class:06X}"
                
                # Check if it's an audio device class
                is_audio_class = (device_class & 0x200000) != 0  # Audio service class bit
                major_class = (device_class >> 8) & 0x1F
                minor_class = (device_class >> 2) & 0x3F
                
                print(f"Device Class: {device_class_hex}")
                print(f"  Audio Service Class: {'Yes' if is_audio_class else 'No'}")
                print(f"  Major Device Class: {major_class} ({'Audio/Video' if major_class == 4 else 'Other'})")
                print(f"  Minor Device Class: {minor_class}")
                
                if device_class == 0x200414:
                    print("  ✓ Correctly configured as Audio Sink")
                elif is_audio_class:
                    print("  ⚠ Audio device but not optimal for sink")
                else:
                    print("  ✗ Not configured as audio device")
                
            except Exception as e:
                print(f"Could not read device class: {e}")
            
            # Get current UUIDs
            try:
                uuids = props.Get("org.bluez.Adapter1", "UUIDs")
                print(f"\nAdvertised UUIDs:")
                
                audio_uuids = {
                    "0000110B-0000-1000-8000-00805F9B34FB": "A2DP Sink",
                    "0000110A-0000-1000-8000-00805F9B34FB": "A2DP Source", 
                    "0000110C-0000-1000-8000-00805F9B34FB": "AVRCP Target",
                    "0000110E-0000-1000-8000-00805F9B34FB": "AVRCP Controller",
                    "0000111E-0000-1000-8000-00805F9B34FB": "HFP Hands-Free",
                    "0000111F-0000-1000-8000-00805F9B34FB": "HFP Audio Gateway"
                }
                
                found_audio_profiles = []
                for uuid in uuids:
                    uuid_upper = str(uuid).upper()
                    if uuid_upper in audio_uuids:
                        found_audio_profiles.append(audio_uuids[uuid_upper])
                        print(f"  ✓ {audio_uuids[uuid_upper]} ({uuid_upper})")
                
                if not found_audio_profiles:
                    print("  ✗ No audio profiles found")
                    print("    Try running: btaudio-config --setup-audio")
                else:
                    has_a2dp_sink = "A2DP Sink" in found_audio_profiles
                    has_avrcp = "AVRCP Target" in found_audio_profiles
                    
                    if has_a2dp_sink and has_avrcp:
                        print("  ✓ Audio sink properly configured")
                    elif has_a2dp_sink:
                        print("  ⚠ A2DP Sink found but missing AVRCP (media controls)")
                    else:
                        print("  ✗ Missing A2DP Sink profile")
                        print("    Try running: btaudio-config --setup-audio")
                
            except Exception as e:
                print(f"Could not read UUIDs: {e}")
            
            print("\nTroubleshooting:")
            print("  1. Ensure Bluetooth is powered on")
            print("  2. Make system discoverable: btaudio-config --discoverable")
            print("  3. Set up audio profiles: btaudio-config --setup-audio")
            print("  4. Check if PipeWire/PulseAudio Bluetooth module is loaded")
            
            return True
            
        except Exception as e:
            print(f"Error checking audio profiles: {e}")
            return False

def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    
    parser = argparse.ArgumentParser(description='HiFiBerry Bluetooth Audio Configuration')
    parser.add_argument('--status', action='store_true', help='Show Bluetooth status')
    parser.add_argument('--discoverable', action='store_true', help='Make system discoverable')
    parser.add_argument('--hide', action='store_true', help='Hide from discovery')
    parser.add_argument('--timeout', type=int, default=0, help='Discoverable timeout in seconds (0=infinite)')
    parser.add_argument('--scan', action='store_true', help='Scan for devices')
    parser.add_argument('--pair', help='Pair with device (MAC address)')
    parser.add_argument('--set-pin', help='Set PIN code for secure pairing (4-8 digits)')
    parser.add_argument('--generate-pin', action='store_true', help='Generate and save a random PIN')
    parser.add_argument('--show-pin', action='store_true', help='Show current PIN from config')
    parser.add_argument('--secure-pairing', choices=['DisplayYesNo', 'DisplayOnly', 'KeyboardDisplay', 'NoInputNoOutput'], 
                       default='DisplayYesNo', help='Set secure pairing mode')
    parser.add_argument('--disable-pairing', action='store_true', help='Disable secure pairing agent')
    parser.add_argument('--list-paired', action='store_true', help='List all paired devices')
    parser.add_argument('--remove-device', help='Remove (unpair) device by MAC address')
    parser.add_argument('--remove-all', action='store_true', help='Remove all paired devices')
    parser.add_argument('--setup-audio', action='store_true', help='Configure Bluetooth audio profiles (A2DP sink)')
    parser.add_argument('--check-audio', action='store_true', help='Check if audio profiles are properly configured')
    
    args = parser.parse_args()
    
    bt_manager = BluetoothManager()
    
    if args.status:
        bt_manager.get_status()
    
    elif args.discoverable:
        bt_manager.make_discoverable(args.timeout)
    
    elif args.hide:
        bt_manager.hide_discoverable()
    
    elif args.set_pin:
        # Validate PIN
        if not args.set_pin.isdigit() or len(args.set_pin) < 4 or len(args.set_pin) > 8:
            print("Error: PIN must be 4-8 digits")
            sys.exit(1)
        
        # Save PIN to config
        if bt_manager.save_pin_to_config(args.set_pin):
            print(f"PIN saved to configuration: {args.set_pin}")
            bt_manager.setup_secure_pairing(args.set_pin, args.secure_pairing)
        else:
            print("Error: Could not save PIN to configuration")
            sys.exit(1)
    
    elif args.generate_pin:
        # Generate and save random PIN
        new_pin = bt_manager.generate_random_pin()
        if bt_manager.save_pin_to_config(new_pin):
            print(f"Generated and saved random PIN: {new_pin}")
            bt_manager.setup_secure_pairing(new_pin, args.secure_pairing)
        else:
            print("Error: Could not save PIN to configuration")
            sys.exit(1)
    
    elif args.show_pin:
        # Show current PIN from config
        current_pin = bt_manager.load_pin_from_config()
        if current_pin:
            print(f"Current PIN: {current_pin}")
        else:
            print("No PIN configured")
    
    elif args.disable_pairing:
        bt_manager.remove_secure_pairing()
    
    elif args.list_paired:
        bt_manager.list_paired_devices()
    
    elif args.remove_device:
        # Validate MAC address format (basic check)
        import re
        if not re.match(r'^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$', args.remove_device):
            print("Error: Invalid MAC address format. Use format: XX:XX:XX:XX:XX:XX")
            sys.exit(1)
        
        bt_manager.remove_device(args.remove_device)
    
    elif args.remove_all:
        # Ask for confirmation
        try:
            response = input("Are you sure you want to remove ALL paired devices? (yes/no): ")
            if response.lower() in ['yes', 'y']:
                bt_manager.remove_all_devices()
            else:
                print("Operation cancelled")
        except KeyboardInterrupt:
            print("\nOperation cancelled")
    
    elif args.setup_audio:
        bt_manager.setup_audio_profiles()
    
    elif args.check_audio:
        bt_manager.check_audio_profiles()
    
    elif args.scan:
        print("Scanning for Bluetooth devices...")
        try:
            subprocess.run(['bluetoothctl', 'scan', 'on'])
        except Exception as e:
            print(f"Error: {e}")
    
    elif args.pair:
        print(f"Pairing with device: {args.pair}")
        try:
            subprocess.run(['bluetoothctl', 'pair', args.pair])
        except Exception as e:
            print(f"Error: {e}")
    
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
