#!/usr/bin/env python3
"""
HiFiBerry Bluetooth Audio Web API
Simple REST API for Bluetooth pairing and configuration
"""

import json
import subprocess
import os
import sys
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs
import threading
import time

# Add the directory containing btaudio-config to the path
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

# Import our existing Bluetooth manager
try:
    # Try to import from installed location first
    import sys
    sys.path.insert(0, '/usr/bin')
    from btaudio_config import BluetoothManager
except ImportError:
    # Fallback to local development path
    import importlib.util
    import os
    
    # Try relative path first
    script_dir = os.path.dirname(os.path.abspath(__file__))
    config_path = os.path.join(script_dir, 'btaudio-config')
    
    if not os.path.exists(config_path):
        # Try absolute path
        config_path = '/usr/bin/btaudio-config'
    
    if os.path.exists(config_path):
        spec = importlib.util.spec_from_file_location("btaudio_config", config_path)
        btaudio_module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(btaudio_module)
        BluetoothManager = btaudio_module.BluetoothManager
    else:
        raise ImportError("Could not find btaudio-config module")

class BluetoothAPIHandler(BaseHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
    
    def _get_bt_manager(self):
        """Get Bluetooth manager instance"""
        if not hasattr(self, '_bt_manager'):
            self._bt_manager = BluetoothManager()
        return self._bt_manager
    
    def _send_json_response(self, data, status_code=200):
        """Send JSON response"""
        self.send_response(status_code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Access-Control-Allow-Origin', '*')  # CORS for web apps
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type')
        self.end_headers()
        
        response = json.dumps(data, indent=2)
        self.wfile.write(response.encode('utf-8'))
    
    def _send_error_response(self, message, status_code=400):
        """Send error response"""
        self._send_json_response({'error': message, 'success': False}, status_code)
    
    def do_OPTIONS(self):
        """Handle CORS preflight requests"""
        self.send_response(200)
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type')
        self.end_headers()
    
    def do_GET(self):
        """Handle GET requests"""
        parsed_path = urlparse(self.path)
        path = parsed_path.path
        query_params = parse_qs(parsed_path.query)
        
        try:
            if path == '/api/status':
                # Get Bluetooth status
                response = self._get_bluetooth_status()
                self._send_json_response(response)
            
            elif path == '/api/pairing/pin':
                # Get current PIN
                bt_manager = self._get_bt_manager()
                current_pin = bt_manager.load_pin_from_config()
                self._send_json_response({
                    'pin': current_pin,
                    'has_pin': current_pin is not None,
                    'success': True
                })
            
            elif path == '/api/devices/paired':
                # List paired devices
                bt_manager = self._get_bt_manager()
                devices = bt_manager.list_paired_devices()
                self._send_json_response({
                    'devices': devices,
                    'count': len(devices),
                    'success': True
                })
            
            elif path == '/api/audio/check':
                # Check audio configuration
                audio_status = self._check_audio_status()
                self._send_json_response(audio_status)
            
            elif path == '/':
                # Serve basic HTML interface
                self._serve_html_interface()
            
            else:
                self._send_error_response('Endpoint not found', 404)
                
        except Exception as e:
            self._send_error_response(f'Server error: {str(e)}', 500)
    
    def do_POST(self):
        """Handle POST requests"""
        parsed_path = urlparse(self.path)
        path = parsed_path.path
        
        try:
            # Read request body
            content_length = int(self.headers.get('Content-Length', 0))
            if content_length > 0:
                post_data = self.rfile.read(content_length)
                try:
                    request_data = json.loads(post_data.decode('utf-8'))
                except json.JSONDecodeError:
                    request_data = {}
            else:
                request_data = {}
            
            if path == '/api/pairing/pin/generate':
                # Generate new random PIN
                bt_manager = self._get_bt_manager()
                new_pin = bt_manager.generate_random_pin()
                if bt_manager.save_pin_to_config(new_pin):
                    self._send_json_response({
                        'pin': new_pin,
                        'message': 'Random PIN generated and saved',
                        'success': True
                    })
                else:
                    self._send_error_response('Failed to save PIN')
            
            elif path == '/api/pairing/pin/set':
                # Set custom PIN
                pin = request_data.get('pin', '').strip()
                
                if not pin.isdigit() or len(pin) < 4 or len(pin) > 8:
                    self._send_error_response('PIN must be 4-8 digits')
                    return
                
                bt_manager = self._get_bt_manager()
                if bt_manager.save_pin_to_config(pin):
                    self._send_json_response({
                        'pin': pin,
                        'message': 'PIN saved successfully',
                        'success': True
                    })
                else:
                    self._send_error_response('Failed to save PIN')
            
            elif path == '/api/discoverable/start':
                # Make discoverable
                timeout = request_data.get('timeout', 0)
                bt_manager = self._get_bt_manager()
                if bt_manager.make_discoverable(timeout):
                    self._send_json_response({
                        'message': f'System is now discoverable',
                        'timeout': timeout,
                        'success': True
                    })
                else:
                    self._send_error_response('Failed to make discoverable')
            
            elif path == '/api/discoverable/stop':
                # Hide from discovery
                bt_manager = self._get_bt_manager()
                if bt_manager.hide_discoverable():
                    self._send_json_response({
                        'message': 'System is no longer discoverable',
                        'success': True
                    })
                else:
                    self._send_error_response('Failed to hide from discovery')
            
            elif path == '/api/audio/setup':
                # Setup audio profiles
                bt_manager = self._get_bt_manager()
                if bt_manager.setup_audio_profiles():
                    self._send_json_response({
                        'message': 'Audio profiles configured successfully',
                        'success': True
                    })
                else:
                    self._send_error_response('Failed to setup audio profiles')
            
            else:
                self._send_error_response('Endpoint not found', 404)
                
        except Exception as e:
            self._send_error_response(f'Server error: {str(e)}', 500)
    
    def do_DELETE(self):
        """Handle DELETE requests"""
        parsed_path = urlparse(self.path)
        path = parsed_path.path
        
        try:
            if path.startswith('/api/devices/'):
                # Remove device by MAC address
                mac_address = path.split('/')[-1]
                bt_manager = self._get_bt_manager()
                if bt_manager.remove_device(mac_address):
                    self._send_json_response({
                        'message': f'Device {mac_address} removed successfully',
                        'success': True
                    })
                else:
                    self._send_error_response(f'Failed to remove device {mac_address}')
            
            elif path == '/api/devices/all':
                # Remove all devices
                bt_manager = self._get_bt_manager()
                if bt_manager.remove_all_devices():
                    self._send_json_response({
                        'message': 'All paired devices removed',
                        'success': True
                    })
                else:
                    self._send_error_response('Failed to remove all devices')
            
            else:
                self._send_error_response('Endpoint not found', 404)
                
        except Exception as e:
            self._send_error_response(f'Server error: {str(e)}', 500)
    
    def _get_bluetooth_status(self):
        """Get comprehensive Bluetooth status"""
        try:
            bt_manager = self._get_bt_manager()
            if not bt_manager.adapter:
                return {'error': 'No Bluetooth adapter found', 'success': False}
            
            import dbus
            props = dbus.Interface(bt_manager.adapter, "org.freedesktop.DBus.Properties")
            
            powered = props.Get("org.bluez.Adapter1", "Powered")
            discoverable = props.Get("org.bluez.Adapter1", "Discoverable")
            pairable = props.Get("org.bluez.Adapter1", "Pairable")
            alias = props.Get("org.bluez.Adapter1", "Alias")
            address = props.Get("org.bluez.Adapter1", "Address")
            
            # Get PIN status
            current_pin = bt_manager.load_pin_from_config()
            
            return {
                'adapter': {
                    'address': str(address),
                    'name': str(alias),
                    'powered': bool(powered),
                    'discoverable': bool(discoverable),
                    'pairable': bool(pairable)
                },
                'pairing': {
                    'has_pin': current_pin is not None,
                    'pin': current_pin if current_pin else None
                },
                'success': True
            }
            
        except Exception as e:
            return {'error': f'Failed to get status: {str(e)}', 'success': False}
    
    def _check_audio_status(self):
        """Check audio backend status"""
        try:
            import subprocess
            
            audio_status = {
                'pipewire_running': False,
                'wireplumber_running': False,
                'pulseaudio_running': False,
                'backend': 'none'
            }
            
            # Check PipeWire
            result = subprocess.run(['pgrep', '-x', 'pipewire'], capture_output=True, timeout=5)
            if result.returncode == 0:
                audio_status['pipewire_running'] = True
                audio_status['backend'] = 'pipewire'
                
                # Check WirePlumber
                result = subprocess.run(['pgrep', '-x', 'wireplumber'], capture_output=True, timeout=5)
                audio_status['wireplumber_running'] = (result.returncode == 0)
            else:
                # Check PulseAudio
                result = subprocess.run(['pgrep', '-x', 'pulseaudio'], capture_output=True, timeout=5)
                if result.returncode == 0:
                    audio_status['pulseaudio_running'] = True
                    audio_status['backend'] = 'pulseaudio'
            
            audio_status['success'] = True
            return audio_status
            
        except Exception as e:
            return {'error': f'Failed to check audio status: {str(e)}', 'success': False}
    
