def main():
    import argparse
    
    parser = argparse.ArgumentParser(description='HiFiBerry Bluetooth Audio Web API')
    parser.add_argument('--host', default='127.0.0.1', help='Host to bind to (default: 127.0.0.1)')
    parser.add_argument('--port', type=int, default=1082, help='Port to bind to (default: 1082)')
    
    args = parser.parse_args()
    
    try:
        # Initialize DBus main loop
        import dbus.mainloop.glib
        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
        
        server = HTTPServer((args.host, args.port), BluetoothAPIHandler)
        print(f"Starting HiFiBerry Bluetooth Audio Web API on {args.host}:{args.port}")
        print(f"Web interface available at: http://{args.host}:{args.port}/")
        print("API endpoints:")
        print("  GET  /api/status - Get Bluetooth adapter status")
        print("  GET  /api/pairing/pin - Get current PIN")
        print("  POST /api/pairing/pin/generate - Generate random PIN")
        print("  POST /api/pairing/pin/set - Set custom PIN")
        print("  POST /api/discoverable/start - Make discoverable")
        print("  POST /api/discoverable/stop - Hide from discovery")
        print("  GET  /api/devices/paired - List paired devices")
        print("  DELETE /api/devices/{mac} - Remove device")
        print("  DELETE /api/devices/all - Remove all devices")
        print("  GET  /api/audio/check - Check audio status")
        print("  POST /api/audio/setup - Setup audio profiles")
        print("\nPress Ctrl+C to stop the server")
        
        server.serve_forever()
        
    except KeyboardInterrupt:
        print("\nShutting down server...")
        server.shutdown()
        server.server_close()
        print("Server stopped")

if __name__ == "__main__":
    main()
