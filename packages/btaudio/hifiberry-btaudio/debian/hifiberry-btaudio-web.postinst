#!/bin/bash
set -e

case "$1" in
    configure)
        # Make btaudio-web-api executable
        chmod +x /opt/hifiberry/bin/btaudio-web-api
        
        # Install and enable the systemd service
        if [ -d /run/systemd/system ]; then
            # Service file should be installed via dh_installsystemd
            # Just reload and enable
            systemctl daemon-reload
            
            # Enable but don't start the service (user can start manually)
            systemctl enable hifiberry-btaudio-web.service
            
            echo "HiFiBerry Bluetooth Audio Web API installed."
            echo "Start with: systemctl start hifiberry-btaudio-web"
            echo "Web interface will be available at: http://$(hostname -I | awk '{print $1}'):8080/"
        fi
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
