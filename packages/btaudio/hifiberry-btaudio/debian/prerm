#!/bin/bash

set -e

case "$1" in
    remove|purge)
        echo "Stopping HiFiBerry Bluetooth Audio service..."
        
        # Stop and disable the service
        systemctl stop hifiberry-btaudio.service || true
        systemctl disable hifiberry-btaudio.service || true
        
        echo "HiFiBerry Bluetooth Audio service stopped"
        ;;
        
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Don't clean up during upgrades
        ;;
        
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
