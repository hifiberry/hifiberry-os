#!/bin/bash

set -e

case "$1" in
    remove|purge)
        echo "Removing HiFiBerry Bluetooth Audio metapackage..."
        echo "Note: Core Bluetooth and audio services will remain available"
        ;;
        
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Don't clean up during upgrades
        ;;
        
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
