#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	# Make scripts executable
	chmod +x src/btaudio-*

override_dh_auto_test:
	# Skip tests for now

override_dh_installsystemd:
	# Install systemd service for main package
	dh_installsystemd --package=hifiberry-btaudio systemd/hifiberry-btaudio.service
	# Install systemd service for web API
	dh_installsystemd --package=hifiberry-btaudio debian/hifiberry-btaudio-web.service
