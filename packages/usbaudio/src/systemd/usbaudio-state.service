[Unit]
Description=HiFiBerry USB Audio Gadget State Reporter (ACR)
After=pipewire.service

[Service]
Type=simple
# --card is REQUIRED: hifiberry_usbaudio.state.run() refuses to start
# without it, precisely to stop this unit from silently misreporting the
# DAC's own playback to ACR as the USB gadget playing (see state.py).
#
# PLACEHOLDER_PIN_DURING_BRINGUP below is a deliberately-invalid value --
# it matches no real /proc/asound card, so until it is replaced this
# service simply reports "stopped" instead of anything wrong. Replace it
# with the gadget's real /proc/asound card name/id (e.g. "gadget") once
# that is confirmed on hardware bring-up (see linker.py's
# GADGET_NODE_PREFIX note and README.md).
ExecStart=/usr/bin/hifiberry-usbaudio state --card PLACEHOLDER_PIN_DURING_BRINGUP

[Install]
WantedBy=default.target
